---
import { getLocale, localizedPath } from '../lib/i18n';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
}

const locale = getLocale(Astro.url.pathname);
const {
	title,
	description,
	noindex = false,
	image = '/og/fedor-jurecki-portfolio-en.png',
	imageAlt = locale === 'ru' ? 'Федор Юрецкий — графический дизайнер' : 'Fedor Jurecki — graphic designer',
} = Astro.props;

const site = Astro.site ?? new URL('https://jurecki-portfolio.vercel.app');
const canonicalPath = ['/', '/ru/'].includes(Astro.url.pathname) ? Astro.url.pathname : Astro.url.pathname.replace(/\/+$/, '');
const canonical = new URL(canonicalPath, site).toString();
const englishUrl = new URL(localizedPath(Astro.url.pathname, 'en'), site).toString();
const russianUrl = new URL(localizedPath(Astro.url.pathname, 'ru'), site).toString();
const socialImage = new URL(image, site).toString();
const personId = new URL('/#fedor-jurecki', site).toString();
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': personId,
	name: 'Fedor Jurecki',
	url: new URL('/', site).toString(),
	image: socialImage,
	description: locale === 'ru' ? 'Графический дизайнер с экспертизой в многостраничной вёрстке, инфографике и брендинге.' : 'Graphic designer specializing in editorial design, infographics, and branding.',
	jobTitle: locale === 'ru' ? 'Графический дизайнер' : 'Graphic Designer',
	address: {
		'@type': 'PostalAddress',
		addressLocality: locale === 'ru' ? 'Астана' : 'Astana',
		addressCountry: 'KZ',
	},
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.ico?v=2" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={englishUrl} />
<link rel="alternate" hreflang="ru" href={russianUrl} />
<link rel="alternate" hreflang="x-default" href={englishUrl} />
<link rel="sitemap" href={new URL('/sitemap.xml', site).toString()} />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, noimageindex, follow' : 'index, follow, max-image-preview:large'} />
<meta name="theme-color" content="#050505" />
<title>{title}</title>

<meta property="og:type" content="website" />
<meta property="og:locale" content={locale === 'ru' ? 'ru_KZ' : 'en_US'} />
<meta property="og:site_name" content="Fedor Jurecki" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:secure_url" content={socialImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
