---
import CaseLightbox from './CaseLightbox.astro';
---

<footer class="project-footer">
	<nav class="footer-contacts" aria-label="Контакты Федора Юрецкого">
		<button class="footer-copy" type="button" data-copy-value="fedorjurecki@gmail.com" data-copy-message="Почта скопирована" aria-label="Скопировать почту fedorjurecki@gmail.com">
			<span>Почта <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="2.5" width="8" height="8" rx="1"></rect><path d="M10.5 10.5v2a1 1 0 0 1-1 1h-7v-8a1 1 0 0 1 1-1h2"></path></svg></span>
		</button>
		<a href="https://t.me/jurecki" target="_blank" rel="noopener noreferrer">Telegram ↗</a>
		<a href="https://www.linkedin.com/in/jurecki" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
		<a href="https://www.instagram.com/jurecki.things/" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
	</nav>
	<a class="footer-home" href="/"><strong>Вернуться на главную <span class="footer-arrow" aria-hidden="true">→</span></strong></a>
</footer>

<CaseLightbox id="case-image-lightbox" variant="single" label="Увеличенное изображение проекта" />

<script>
	document.querySelectorAll<HTMLImageElement>('main img').forEach((image) => {
		if (image.closest('button, a, dialog, [data-no-zoom]') || image.classList.contains('case-image-zoomable')) return;
		image.classList.add('case-image-zoomable');
		image.dataset.lightboxTarget = 'case-image-lightbox';
		image.dataset.caption = image.alt;
		image.tabIndex = 0;
		image.setAttribute('role', 'button');
		image.setAttribute('aria-label', image.alt ? `Увеличить: ${image.alt}` : 'Увеличить изображение');
		image.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			image.click();
		});
	});
</script>

<style>
	.project-footer {
		width: 100%;
		max-width: 88rem;
		min-height: clamp(10rem, 17vw, 16rem);
		margin: clamp(8rem, 13vw, 13rem) auto 0;
		padding: clamp(2rem, 4vw, 4rem) 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: clamp(2rem, 5vw, 6rem);
		border-top: 1px solid rgba(17,17,17,.12);
		color: #111;
	}
	.project-footer > *,.footer-contacts > * { min-width: 0; }

	.footer-contacts {
		display: grid;
		grid-template-columns: repeat(2, max-content);
		gap: 1.15rem clamp(1.5rem, 3vw, 3rem);
	}

	.footer-contacts a,
	.footer-contacts button {
		padding: 0;
		color: #111;
		background: transparent;
		border: 0;
		font: inherit;
		font-size: .68rem;
		font-weight: 750;
		line-height: 1.3;
		text-align: left;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
	}

	.footer-copy span { display:flex; align-items:center; gap:.35rem; }
	.footer-copy svg { width:.9rem; height:.9rem; fill:none; stroke:currentColor; stroke-width:1.4; stroke-linecap:round; stroke-linejoin:round; }
	.footer-contacts a:hover,
	.footer-contacts button:hover { color: var(--color-accent); }

	.footer-home { flex: 0 1 auto; color: inherit; text-decoration: none; }

	.footer-home strong {
		display: flex;
		align-items: center;
		gap: .18em;
		font-size: var(--text-display-subsection);
		line-height: var(--leading-display-subsection);
		letter-spacing: var(--tracking-display-subsection);
		text-align: right;
	}

	.footer-arrow {
		flex: 0 0 auto;
		font-size: .72em;
		font-weight: 500;
		line-height: 1;
		transition: transform .2s ease;
	}

	.footer-home:hover .footer-arrow { transform: translateX(.2rem); }

	:global(main img.case-image-zoomable) { cursor: zoom-in; }
	:global(main img.case-image-zoomable:focus-visible) { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	.footer-home:focus-visible,
	.footer-contacts a:focus-visible,
	.footer-contacts button:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	@media (max-width: 700px) {
		.project-footer {
			min-height: 10rem;
			margin-top: 7rem;
			padding-block: 2.5rem;
			align-items: flex-start;
			flex-direction: column;
		}

		.footer-contacts {
			width: 100%;
			grid-template-columns: repeat(2, minmax(0,1fr));
			gap: 1rem;
		}

		.footer-contacts a,
		.footer-contacts button { font-size:.75rem; line-height:1.45; white-space: normal; }
		.footer-home strong {
			max-width: 18rem;
			font-size: clamp(2rem, 10vw, 3rem);
			text-align: left;
		}

		.footer-arrow { font-size: .65em; }
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-arrow { transition-duration: .01ms; }
	}
</style>
