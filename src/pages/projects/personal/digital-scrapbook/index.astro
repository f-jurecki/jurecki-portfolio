---
import CasePagination from '../../../../components/CasePagination.astro';
import ProjectFooter from '../../../../components/ProjectFooter.astro';
import ResponsiveImage from '../../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getLocale } from '../../../../lib/i18n';

const isRu = getLocale(Astro.url.pathname) === 'ru';

const pages = Array.from({ length: 24 }, (_, index) => {
	const number = String(index + 1).padStart(2, '0');
	return { src: `/portfolio/personal/digital-scrapbook/page-${number}.webp`, alt: `Digital Scrapbook, ${isRu ? 'страница' : 'page'} ${index + 1}` };
});

const spreads = pages.reduce<typeof pages[]>((result, page, index) => {
	if (index === 0 || index % 2 === 1) result.push([page]);
	else result.at(-1)?.push(page);
	return result;
}, []);
---

<BaseLayout
	title={isRu ? 'Digital Scrapbook — Федор Юрецкий' : 'Digital Scrapbook — Fedor Jurecki'}
	description={isRu ? 'Digital Scrapbook — личный визуальный дневник Федора Юрецкого, собранный из фрагментов цифровой жизни.' : 'A personal visual diary assembled from screenshots, interfaces, memes, and other fragments of digital life.'}
>
	<SiteHeader />

	<main class="scrapbook-page">
		<section class="scrapbook-intro" aria-labelledby="scrapbook-title">
			<h1 id="scrapbook-title">Digital<br />Scrapbook</h1>
			<div class="intro-copy">
				<p>{isRu ? 'Я увидел референс цифрового скрапбука и захотел сделать что-то похожее — сохранить принцип традиционного скрапбука, но перенести его в цифровое пространство. Вместо бумажных вырезок здесь собраны скриншоты, интерфейсы, мемы и другие фрагменты повседневной жизни на экране. Получился личный визуальный дневник, собранный из цифровых находок.' : 'I came across a digital-scrapbook reference and wanted to make something similar: keep the logic of traditional scrapbooking, but move it into a digital space. Instead of paper cut-outs, it collects screenshots, interfaces, memes, and other fragments of everyday life on a screen. The result is a personal visual diary assembled from digital finds.'}</p>
				<ResponsiveImage
					src="/portfolio/personal/digital-scrapbook/reference.jpg"
					alt={isRu ? 'Референс цифрового скрапбука' : 'Digital scrapbook reference'}
					widths={[160, 240, 360]}
					sizes="(max-width: 800px) 28vw, 11rem"
				/>
			</div>
		</section>

		<section class="book" aria-label={`Digital Scrapbook, 24 ${isRu ? 'страницы' : 'pages'}`} data-book>
			<div class="book-controls">
				<strong aria-live="polite"><span data-current>1</span> / <span data-total>{spreads.length}</span></strong>
				<button type="button" data-step="-1" aria-label={isRu ? 'Предыдущий разворот' : 'Previous spread'}>←</button>
				<button type="button" data-step="1" aria-label={isRu ? 'Следующий разворот' : 'Next spread'}>→</button>
			</div>

			<div class="book-gallery" data-gallery tabindex="0" aria-label={isRu ? 'Листать Digital Scrapbook' : 'Browse Digital Scrapbook'}>
				{spreads.map((spread, spreadIndex) => (
					<figure class:list={[spread.length === 1 && 'book-single']} data-active={spreadIndex === 0 ? '' : undefined}>
						<div class="book-spread">
							{spread.map((page, pageIndex) => (
								<ResponsiveImage
									src={page.src}
									alt={page.alt}
									widths={[320, 480, 720, 951]}
									sizes="(max-width: 800px) 100vw, 42vw"
									loading={spreadIndex === 0 && pageIndex === 0 ? 'eager' : 'lazy'}
								/>
							))}
						</div>
						<figcaption>
							{spread.length === 1
								? String(spreadIndex === 0 ? 1 : spreadIndex * 2).padStart(2, '0')
								: `${String(spreadIndex * 2).padStart(2, '0')}–${String(spreadIndex * 2 + 1).padStart(2, '0')}`}
						</figcaption>
					</figure>
				))}
			</div>
		</section>
	</main>
	<CasePagination
		previous={{ href: '/projects/personal/posters/', label: isRu ? 'Постеры' : 'Posters' }}
		next={{ href: '/projects/vibecoding/adobe-scripts/', label: isRu ? 'Скрипты для Adobe' : 'Adobe Scripts' }}
	/>
	<ProjectFooter />
</BaseLayout>

<script>
	document.querySelectorAll<HTMLElement>('[data-book]').forEach((book) => {
		const mobile = matchMedia('(max-width: 800px)');
		const gallery = book.querySelector<HTMLElement>('[data-gallery]');
		const spreads = [...(gallery?.querySelectorAll<HTMLElement>('figure') ?? [])];
		const pages = [...(gallery?.querySelectorAll<HTMLImageElement>('img') ?? [])];
		const current = book.querySelector<HTMLElement>('[data-current]');
		const total = book.querySelector<HTMLElement>('[data-total]');
		const buttons = [...book.querySelectorAll<HTMLButtonElement>('[data-step]')];
		let index = 0;

		const update = (next: number) => {
			const items = mobile.matches ? pages : spreads;
			index = Math.max(0, Math.min(items.length - 1, next));
			spreads.forEach((spread, spreadIndex) => spread.toggleAttribute('data-active', mobile.matches ? spread.contains(pages[index]) : spreadIndex === index));
			pages.forEach((page, pageIndex) => page.toggleAttribute('data-mobile-active', mobile.matches && pageIndex === index));
			if (current) current.textContent = String(index + 1);
			if (total) total.textContent = String(items.length);
			buttons[0].disabled = index === 0;
			buttons[1].disabled = index === items.length - 1;
		};

		buttons.forEach((button) => button.addEventListener('click', () => update(index + Number(button.dataset.step))));

		gallery?.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
			event.preventDefault();
			update(index + (event.key === 'ArrowRight' ? 1 : -1));
		});
		mobile.addEventListener('change', () => update(0));
		update(0);
	});
</script>

<style>
	.scrapbook-page { width: min(100%,100rem); margin-inline: auto; padding: clamp(3rem,7vw,7rem) clamp(.75rem,3vw,3rem) clamp(5rem,10vw,10rem); }
	.scrapbook-intro { display: grid; grid-template-columns: minmax(18rem,.8fr) minmax(30rem,1.2fr); align-items: start; gap: clamp(3rem,8vw,9rem); }
	h1 { margin: 0; font-size: var(--text-page-title); font-weight: var(--weight-page-title); line-height: var(--leading-page-title); letter-spacing: var(--tracking-page-title); }
	.intro-copy { display: grid; grid-template-columns: minmax(0,1fr) clamp(8rem,13vw,11rem); align-items: start; gap: clamp(1rem,2vw,2rem); }
	.scrapbook-intro p { margin: 0; color: var(--color-muted); font-size: var(--text-body-lg); line-height: var(--leading-body-lg); }
	.intro-copy :global(img) { width: 100%; height: auto; display: block; }
	.book { margin-top: clamp(4rem,8vw,8rem); min-width: 0; display: grid; grid-template: "counter counter counter" auto "previous gallery next" auto / 3rem minmax(0,1fr) 3rem; align-items: center; gap: .75rem; }
	.book-controls { display: contents; }
	.book-controls strong { grid-area: counter; color: var(--color-muted); font-size: var(--text-caption); letter-spacing: var(--tracking-caption); }
	.book-controls button { width: 3rem; height: 3rem; padding: 0; color: var(--color-text); background: var(--color-panel); border: 1px solid var(--color-border); cursor: pointer; }
	.book-controls button:first-of-type { grid-area: previous; }
	.book-controls button:last-of-type { grid-area: next; }
	.book-controls button:hover { color: #050505; background: #fff; border-color: #fff; }
	.book-controls button:disabled { color: #555; background: #090909; border-color: #222; cursor: default; }
	.book-gallery { grid-area: gallery; min-width: 0; }
	.book-gallery figure { display: none; margin: 0; min-width: 0; }
	.book-gallery figure[data-active] { display: block; }
	.book-spread { --spread-gap: .3rem; box-sizing: border-box; width: 100%; padding: clamp(.5rem,1.5vw,1.25rem); display: flex; justify-content: center; align-items: center; gap: var(--spread-gap); background: var(--color-panel); border: 1px solid var(--color-border); }
	.book-spread :global(img) { width: auto; max-width: calc((100% - var(--spread-gap)) / 2); height: auto; max-height: calc(100dvh - 8rem); display: block; object-fit: contain; }
	.book-single .book-spread :global(img) { max-width: 50%; }
	figcaption { padding-top: .5rem; color: var(--color-muted); font-size: var(--text-caption); letter-spacing: var(--tracking-caption); }
	.book-controls button:focus-visible,.book-gallery:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	@media (max-width: 800px) {
		.scrapbook-page { padding-top: 3.5rem; }
		.scrapbook-intro { grid-template-columns: 1fr; gap: 2rem; }
		.intro-copy { grid-template-columns: minmax(0,1fr) minmax(6rem,28vw); }
		.book { margin-top: 3.5rem; grid-template: "counter counter counter" auto "gallery gallery gallery" auto "previous . next" auto / 2.5rem minmax(0,1fr) 2.5rem; gap: .75rem .35rem; }
		.book-controls button { width: 2.5rem; height: 2.5rem; }
		.book-spread { display: block; padding: .4rem; }
		.book-spread :global(img) { display: none; width: 100%; max-width: none; max-height: none; }
		.book-spread :global(img[data-mobile-active]) { display: block; }
		.book-single .book-spread :global(img) { max-width: none; }
		.book-gallery figcaption { display: none; }
	}
</style>
