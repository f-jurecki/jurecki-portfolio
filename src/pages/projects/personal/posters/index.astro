---
import SiteHeader from '../../../../components/SiteHeader.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const posterCount = 35;
const posters = Array.from({ length: posterCount }, (_, index) => {
	const number = String(index + 1).padStart(2, '0');
	return {
		full: `/portfolio/posters/poster-${number}.webp`,
		thumb: `/portfolio/posters/thumbs/poster-${number}.webp`,
		alt: `Постер ${index + 1} из ${posterCount}`,
	};
});
---

<BaseLayout
	title="Постеры — Федор Юрецкий"
	description="Экспериментальные постеры Федора Юрецкого."
>
	<SiteHeader />

	<main class="poster-page">
		<section class="poster-gallery" aria-label="Галерея постеров" data-poster-gallery>
			<div class="poster-stage">
				<button class="poster-arrow poster-arrow--previous" type="button" aria-label="Предыдущий постер" data-previous>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" /></svg>
				</button>

				<div class="poster-frame">
					<img src={posters[0].full} alt={posters[0].alt} fetchpriority="high" decoding="async" data-main-poster />
				</div>

				<button class="poster-arrow poster-arrow--next" type="button" aria-label="Следующий постер" data-next>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
				</button>
			</div>

			<div class="poster-thumbnails" role="list" aria-label="Выбрать постер" data-thumbnails>
				{posters.map((poster, index) => (
					<button
						type="button"
						role="listitem"
						aria-label={`Показать постер ${index + 1}`}
						aria-current={index === 0 ? 'true' : undefined}
						data-poster-index={index}
						data-poster-src={poster.full}
						data-poster-alt={poster.alt}
					>
						<img src={poster.thumb} alt="" width="220" height="220" loading={index < 8 ? 'eager' : 'lazy'} decoding="async" />
					</button>
				))}
			</div>

			<p class="visually-hidden" aria-live="polite" data-poster-status>Показан постер 1 из {posterCount}</p>
		</section>

		<section class="poster-copy" aria-label="О проекте">
			<p><strong>Моя отдушина!</strong></p>
			<p>Люблю отработать на постере новые фишки, методы и инструменты, отразить какую-то эмоцию. Каждый постер — в каком-то смысле эксперимент.</p>
			<p>Инструменты, которые использовались: Illustrator, Photoshop, Procreate, Affinity, металлический лист, майнкрафт, pilot parallel pen, мои фотоработы, каллиграфия, карандаши, и что только не.</p>
		</section>
	</main>
</BaseLayout>

<script>
	const gallery = document.querySelector<HTMLElement>('[data-poster-gallery]');
	const mainPoster = gallery?.querySelector<HTMLImageElement>('[data-main-poster]');
	const thumbnails = Array.from(gallery?.querySelectorAll<HTMLButtonElement>('[data-poster-index]') ?? []);
	const status = gallery?.querySelector<HTMLElement>('[data-poster-status]');
	let currentIndex = 0;

	const showPoster = (nextIndex: number, moveFocus = false) => {
		if (!mainPoster || thumbnails.length === 0) return;
		currentIndex = (nextIndex + thumbnails.length) % thumbnails.length;
		const activeThumbnail = thumbnails[currentIndex];
		mainPoster.src = activeThumbnail.dataset.posterSrc ?? '';
		mainPoster.alt = activeThumbnail.dataset.posterAlt ?? '';
		thumbnails.forEach((thumbnail, index) => {
			if (index === currentIndex) thumbnail.setAttribute('aria-current', 'true');
			else thumbnail.removeAttribute('aria-current');
		});
		activeThumbnail.scrollIntoView({ block: 'nearest', inline: 'center' });
		if (moveFocus) activeThumbnail.focus();
		if (status) status.textContent = `Показан постер ${currentIndex + 1} из ${thumbnails.length}`;
	};

	gallery?.querySelector('[data-previous]')?.addEventListener('click', () => showPoster(currentIndex - 1));
	gallery?.querySelector('[data-next]')?.addEventListener('click', () => showPoster(currentIndex + 1));
	thumbnails.forEach((thumbnail, index) => thumbnail.addEventListener('click', () => showPoster(index)));

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
		if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
		event.preventDefault();
		showPoster(currentIndex + (event.key === 'ArrowRight' ? 1 : -1));
	});
</script>

<style>
	.poster-page {
		width: min(100%, 92rem);
		margin-inline: auto;
		padding: clamp(.75rem, 2vw, 1.75rem) clamp(.75rem, 3vw, 3rem) clamp(4rem, 8vw, 8rem);
	}

	.poster-gallery { min-width: 0; }

	.poster-stage {
		height: clamp(32rem, 68svh, 54rem);
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr) 3.5rem;
		align-items: center;
		gap: clamp(.6rem, 2vw, 1.5rem);
		background: var(--color-panel);
		border: 1px solid var(--color-border);
	}

	.poster-frame {
		position: relative;
		min-width: 0;
		min-height: 0;
		height: calc(100% - clamp(2rem, 5vw, 4rem));
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.poster-frame img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		object-fit: contain;
	}

	.poster-arrow {
		width: 3.5rem;
		height: 3.5rem;
		padding: 0;
		display: grid;
		place-items: center;
		color: var(--color-text);
		background: transparent;
		border: 1px solid var(--color-border);
		cursor: pointer;
	}

	.poster-arrow:hover { color: #050505; background: #fff; }
	.poster-arrow--previous { justify-self: end; }
	.poster-arrow--next { justify-self: start; }
	.poster-arrow svg { width: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: square; stroke-linejoin: miter; }

	.poster-thumbnails {
		margin-top: .75rem;
		padding: .65rem;
		display: flex;
		gap: .55rem;
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-inline: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--color-muted) transparent;
		background: var(--color-panel);
		border: 1px solid var(--color-border);
	}

	.poster-thumbnails button {
		width: 4.25rem;
		height: 5.4rem;
		padding: .2rem;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		background: #050505;
		border: 1px solid transparent;
		cursor: pointer;
	}

	.poster-thumbnails button[aria-current="true"] { border-color: #fff; }
	.poster-thumbnails img { width: 100%; height: 100%; display: block; object-fit: contain; }

	.poster-copy {
		width: min(100%, 46rem);
		margin: clamp(3.5rem, 7vw, 7rem) auto 0;
		color: var(--color-muted);
		font-size: var(--text-body-lg);
		font-weight: 430;
		line-height: var(--leading-body-lg);
	}

	.poster-copy p { margin: 0 0 1.25rem; }
	.poster-copy p:last-child { margin-bottom: 0; }
	.poster-copy strong { color: var(--color-text); font-size: clamp(1.45rem, 2vw, 2rem); font-weight: 620; letter-spacing: -.045em; }

	.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
	:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	@media (max-width: 700px) {
		.poster-page { padding-inline: .75rem; }
		.poster-stage { height: min(63svh, 38rem); min-height: 25rem; grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem; gap: .35rem; }
		.poster-frame { height: calc(100% - 2rem); }
		.poster-arrow { width: 2.5rem; height: 3.25rem; border-color: transparent; }
		.poster-thumbnails { margin-top: .5rem; padding: .5rem; }
		.poster-thumbnails button { width: 3.5rem; height: 4.5rem; }
		.poster-copy { margin-top: 3.5rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.poster-thumbnails { scroll-behavior: auto; }
	}
</style>
