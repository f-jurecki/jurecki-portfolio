---
import CaseLightbox from '../../../../components/CaseLightbox.astro';
import ResponsiveImage from '../../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const ranks = ['Туз', '2', '3', '4', '5', '6', '7', '8', '9', '10', 'Валет', 'Дама', 'Король'];
const suits = [
	{ name: 'Черви', files: [8, 4, 12, 16, 20, 24, 28, 32, 36, 40, 41, 43, 49] },
	{ name: 'Пики', files: [7, 3, 11, 15, 19, 23, 27, 31, 35, 39, 42, 46, 50] },
	{ name: 'Трефы', files: [5, 1, 9, 13, 17, 21, 25, 29, 33, 37, 44, 47, 51] },
	{ name: 'Бубны', files: [6, 2, 10, 14, 18, 22, 26, 30, 34, 38, 45, 48, 52] },
].map((suit) => ({
	...suit,
	cards: suit.files.map((file, index) => ({
		src: `/portfolio/cards/card-${String(file).padStart(2, '0')}.webp`,
		alt: `${suit.name}, ${ranks[index].toLowerCase()}`,
		caption: `${suit.name} · ${ranks[index]}`,
	})),
}));
---

<BaseLayout
	title="Колода карт Misprint — Федор Юрецкий"
	description="Misprint — авторская колода игральных карт Федора Юрецкого: четыре масти и четыре сценария цифрового искажения."
>
	<SiteHeader />

	<main class="cards-page">
		<section class="cards-intro" aria-labelledby="cards-title">
			<div class="cards-heading">
				<h1 id="cards-title">Колода карт Misprint</h1>
				<button class="back-card" type="button" data-lightbox-target="cards-lightbox" data-caption="Рубашка колоды" aria-label="Увеличить рубашку колоды">
					<ResponsiveImage
						src="/portfolio/cards/card-53.webp"
						alt="Рубашка авторской колоды"
						widths={[96, 160, 240, 373]}
						sizes="(max-width: 800px) 6rem, 7vw"
						loading="eager"
					/>
				</button>
			</div>

			<div class="cards-copy">
				<p>Этот пет-проект — авторская колода игральных карт, построенная на сочетании классической карточной системы и эстетики цифрового искажения. В рамках проекта я с нуля отрисовал всю колоду без использования ИИ: все четыре масти, все числовые и фигурные карты, а также рубашку.</p>

				<p>После создания исходной графики я перешёл ко второму этапу — разработке и применению искажений. Для этого я собрал собственный инструмент <a href="/projects/vibecoding/dataforge/">Dataforge</a> с помощью вайбкодинга и использовал его как часть дизайн-процесса. Вместо одного универсального приёма для всей колоды я заложил отдельный тип деформации для каждой масти. За счёт этого каждая масть получила свой визуальный язык, а вся серия — дополнительную глубину и системность.</p>
			</div>
		</section>

		<div class="deck" aria-label="Колода из четырёх рядов карт">
			<div class="deck-scroll" tabindex="0" aria-label="Четыре ряда карт, по одной масти в каждом">
				<div class="deck-grid">
					{suits.map((suit) => (
						<div class="suit-row" role="group" aria-label={suit.name}>
							{suit.cards.map((card) => (
								<button
									class="card-button"
									type="button"
									data-lightbox-target="cards-lightbox"
									data-caption={card.caption}
									aria-label={`Увеличить: ${card.caption}`}
								>
									<ResponsiveImage
										src={card.src}
										alt={card.alt}
										widths={[96, 160, 240, 373]}
										sizes="(max-width: 700px) 6rem, 7vw"
									/>
								</button>
							))}
						</div>
					))}
				</div>
			</div>
		</div>

		<section class="deck-copy" aria-label="О визуальной системе колоды">
			<div class="suit-copy">
				<p>Каждой масти соответствует собственный характер искажения:</p>
				<p><strong>Черви —</strong> блочное, низкоразрешённое искажение, которое дробит форму на крупные растровые фрагменты, сохраняя при этом общий силуэт знака.</p>
				<p><strong>Пики —</strong> более агрессивная помеха с горизонтальными сдвигами, рваными контурами и эффектом цифрового сбоя, будто изображение повреждено во время передачи сигнала.</p>
				<p><strong>Трефы —</strong> монохромное искажение, вдохновлённое эстетикой многократного копирования, наложения и деградации отпечатка, где форма постепенно растворяется в шуме и фактуре.</p>
				<p><strong>Бубны —</strong> цветоканальное смещение с разъездом контуров, создающее эффект нестабильной цифровой регистрации и визуальной вибрации.</p>
			</div>

			<p>В итоге проект представляет собой цельную визуальную систему, где традиционная типология игральной колоды соединяется с разными сценариями цифровой деформации. Каждая масть подчиняется собственной логике, а композиция, ритм и карточная сетка объединяют всю колоду в единый законченный объект.</p>
		</section>
	</main>

	<CaseLightbox id="cards-lightbox" variant="single" label="Увеличенная карта" />
</BaseLayout>

<style>
	.cards-page {
		width: min(100%, 100rem);
		margin-inline: auto;
		padding: clamp(3rem, 7vw, 7rem) clamp(.75rem, 3vw, 3rem) clamp(5rem, 10vw, 10rem);
	}

	.cards-intro {
		display: grid;
		grid-template-columns: minmax(18rem, .8fr) minmax(30rem, 1.2fr);
		align-items: start;
		gap: clamp(3rem, 8vw, 9rem);
	}

	.cards-heading {
		position: sticky;
		top: 9rem;
	}

	h1 {
		margin: 0;
		font-size: var(--text-page-title);
		font-weight: var(--weight-page-title);
		line-height: var(--leading-page-title);
		letter-spacing: var(--tracking-page-title);
	}

	.cards-copy,
	.deck-copy {
		color: var(--color-muted);
		font-size: var(--text-body-lg);
		font-weight: 430;
		line-height: var(--leading-body-lg);
	}

	.cards-copy p,
	.deck-copy p { margin: 0 0 1.35rem; }
	.cards-copy p:last-child,
	.deck-copy p:last-child { margin-bottom: 0; }
	.cards-copy a { color: var(--color-text); text-underline-offset: .22em; text-decoration-thickness: 1px; }
	.cards-copy a:hover { color: #d8d8d8; }
	.suit-copy { margin-bottom: 2.5rem; }
	.suit-copy p { margin-bottom: .8rem; }
	.suit-copy p:first-child { margin-bottom: 1.35rem; color: var(--color-text); }
	.suit-copy strong { color: var(--color-text); font-weight: 700; }

	.back-card {
		width: clamp(5rem, 7vw, 7.2rem);
		margin: clamp(2rem, 4vw, 3.5rem) 0 0;
		padding: 0;
		display: block;
		background: transparent;
		border: 0;
		cursor: zoom-in;
	}

	.back-card :global(img),
	.card-button :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.deck { margin-top: clamp(5rem, 9vw, 9rem); }
	.deck-scroll {
		padding-bottom: .75rem;
		overflow-x: auto;
		overscroll-behavior-inline: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--color-muted) transparent;
	}

	.deck-grid {
		min-width: 60rem;
		display: grid;
		gap: clamp(.65rem, 1.1vw, 1.2rem);
	}

	.suit-row {
		display: grid;
		grid-template-columns: repeat(13, minmax(0, 1fr));
		gap: clamp(.3rem, .65vw, .7rem);
	}

	.deck-copy {
		width: min(100%, 52rem);
		margin: clamp(4rem, 8vw, 8rem) 0 0 auto;
	}

	.card-button {
		min-width: 0;
		padding: 0;
		display: block;
		background: transparent;
		border: 0;
		cursor: zoom-in;
		transition: transform .18s ease;
	}

	.card-button:hover { transform: translateY(-.25rem); }
	.card-button:focus-visible,
	.back-card:focus-visible,
	.deck-scroll:focus-visible,
	.cards-copy a:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	@media (max-width: 800px) {
		.cards-page { padding-top: 3.5rem; }
		.cards-intro { grid-template-columns: 1fr; gap: 3rem; }
		.cards-heading { position: static; }
		.back-card { width: 6rem; }
		.deck-grid { min-width: 72rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.card-button { transition-duration: .01ms; }
	}
</style>
