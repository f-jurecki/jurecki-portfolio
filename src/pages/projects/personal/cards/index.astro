---
import CaseLightbox from '../../../../components/CaseLightbox.astro';
import CasePagination from '../../../../components/CasePagination.astro';
import ProjectFooter from '../../../../components/ProjectFooter.astro';
import ResponsiveImage from '../../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getLocale, localizedPath } from '../../../../lib/i18n';
import { cardFiles } from '../../../../lib/solitaire.mjs';

const locale = getLocale(Astro.url.pathname);
const isRu = locale === 'ru';
const ranks = isRu ? ['Туз', '2', '3', '4', '5', '6', '7', '8', '9', '10', 'Валет', 'Дама', 'Король'] : ['Ace', '2', '3', '4', '5', '6', '7', '8', '9', '10', 'Jack', 'Queen', 'King'];
const suits = [
	{ name: isRu ? 'Черви' : 'Hearts', files: cardFiles[0] },
	{ name: isRu ? 'Пики' : 'Spades', files: cardFiles[1] },
	{ name: isRu ? 'Трефы' : 'Clubs', files: cardFiles[2] },
	{ name: isRu ? 'Бубны' : 'Diamonds', files: cardFiles[3] },
].map((suit) => ({
	...suit,
	cards: suit.files.map((file, index) => ({
		src: `/portfolio/cards/card-${String(file).padStart(2, '0')}.webp`,
		alt: `${suit.name}, ${ranks[index].toLowerCase()}`,
		caption: `${suit.name} · ${ranks[index]}`,
	})),
}));
---

<BaseLayout
	title={isRu ? 'Колода карт Misprint — Федор Юрецкий' : 'Misprint Playing Card Deck — Fedor Jurecki'}
	description={isRu ? 'Misprint — авторская колода игральных карт Федора Юрецкого: четыре масти и четыре сценария цифрового искажения.' : 'An original playing-card deck combining a classic card system with four modes of digital distortion.'}
>
	<SiteHeader />

	<main class="cards-page">
		<section class="cards-intro" aria-labelledby="cards-title">
			<div class="cards-heading">
				<h1 id="cards-title">{isRu ? <>Колода<br />карт<br />Misprint</> : <>Misprint<br />Playing Card<br />Deck</>}</h1>
				<a class="play-solitaire" href={localizedPath('/projects/personal/cards/solitaire/', locale)}><span aria-hidden="true">♠</span> {isRu ? 'Сыграть в косынку' : 'Play solitaire'} <span aria-hidden="true">↗</span></a>
				<button class="back-card" type="button" data-lightbox-target="cards-lightbox" data-caption={isRu ? 'Рубашка колоды' : 'Card back'} aria-label={isRu ? 'Увеличить рубашку колоды' : 'Enlarge card back'}>
					<ResponsiveImage
						src="/portfolio/cards/card-53.webp"
						alt={isRu ? 'Рубашка авторской колоды' : 'Back of the original playing-card deck'}
						widths={[96, 160, 240, 373]}
						sizes="(max-width: 800px) 6rem, 7vw"
						loading="eager"
					/>
				</button>
			</div>

			<section class="cards-process" aria-label={isRu ? 'Колода Misprint' : 'Misprint deck'}>
				<button class="process-button" type="button" data-lightbox-target="cards-lightbox" data-caption={isRu ? 'Колода Misprint' : 'Misprint deck'} aria-label={isRu ? 'Увеличить демонстрацию колоды' : 'Enlarge deck demonstration'}>
					<img src="/portfolio/cards/process-01.gif" alt={isRu ? 'Демонстрация колоды карт Misprint' : 'Misprint playing-card deck demonstration'} width="272" height="480" loading="eager" decoding="async" />
				</button>
				<button class="process-button" type="button" data-lightbox-target="cards-lightbox" data-caption={isRu ? 'Карточный домик' : 'House of cards'} aria-label={isRu ? 'Увеличить карточный домик' : 'Enlarge house of cards'}>
					<img src="/portfolio/cards/process-02.gif" alt={isRu ? 'Карточный домик' : 'House of cards'} width="272" height="480" loading="eager" decoding="async" />
				</button>
			</section>

			<div class="cards-copy">
				<p>{isRu ? 'Этот пет-проект — авторская колода игральных карт, построенная на сочетании классической карточной системы и эстетики цифрового искажения. В рамках проекта я с нуля отрисовал всю колоду без использования ИИ: все четыре масти, все числовые и фигурные карты, а также рубашку.' : 'This personal project is an original playing-card deck built around the contrast between a classic card system and the aesthetics of digital distortion. I drew the entire deck from scratch without using AI: all four suits, every number and face card, and the card back.'}</p>

				<p>{isRu ? <>После создания исходной графики я перешёл ко второму этапу — разработке и применению искажений. Для этого я собрал собственный инструмент <a href={localizedPath('/projects/vibecoding/deepfries/', locale)}>Deepfries</a> с помощью вайбкодинга и использовал его как часть дизайн-процесса. Вместо одного универсального приёма для всей колоды я заложил отдельный тип деформации для каждой масти. За счёт этого каждая масть получила свой визуальный язык, а вся серия — дополнительную глубину и системность.</> : <>After creating the base artwork, I moved on to the second stage: developing and applying the distortions. I built my own tool, <a href={localizedPath('/projects/vibecoding/deepfries/', locale)}>Deepfries</a>, through vibe coding and used it as part of the design process. Rather than applying one universal effect to the whole deck, I created a different type of distortion for each suit. This gave each suit its own visual language while adding more depth and system to the series as a whole.</>}</p>
			</div>
		</section>

		<div class="deck" aria-label={isRu ? 'Колода из четырёх рядов карт' : 'Deck arranged in four rows'}>
			<div class="deck-scroll" tabindex="0" aria-label={isRu ? 'Четыре ряда карт, по одной масти в каждом' : 'Four rows of cards, one suit per row'}>
				<div class="deck-grid">
					{suits.map((suit) => (
						<div class="suit-row" role="group" aria-label={suit.name}>
							{suit.cards.map((card) => (
								<button
									class="card-button"
									type="button"
									data-lightbox-target="cards-lightbox"
									data-caption={card.caption}
									aria-label={`${isRu ? 'Увеличить' : 'Enlarge'}: ${card.caption}`}
								>
									<ResponsiveImage
										src={card.src}
										alt={card.alt}
										widths={[96, 160, 240, 373]}
										sizes="(max-width: 700px) 6rem, 7vw"
									/>
								</button>
							))}
						</div>
					))}
				</div>
			</div>
		</div>

		<section class="deck-copy" aria-label={isRu ? 'О визуальной системе колоды' : 'About the deck’s visual system'}>
			<div class="suit-copy">
				<p>{isRu ? 'Каждой масти соответствует собственный характер искажения:' : 'Each suit has its own distortion:'}</p>
				<p><strong>{isRu ? 'Черви —' : 'Hearts —'}</strong> {isRu ? 'блочное, низкоразрешённое искажение, которое дробит форму на крупные растровые фрагменты, сохраняя при этом общий силуэт знака.' : 'blocky, low-resolution distortion that breaks the form into large raster fragments while preserving the overall silhouette of the symbol.'}</p>
				<p><strong>{isRu ? 'Пики —' : 'Spades —'}</strong> {isRu ? 'более агрессивная помеха с горизонтальными сдвигами, рваными контурами и эффектом цифрового сбоя, будто изображение повреждено во время передачи сигнала.' : 'a more aggressive interference effect with horizontal shifts, broken contours, and the feel of a digital signal failure, as though the image were damaged in transmission.'}</p>
				<p><strong>{isRu ? 'Трефы —' : 'Clubs —'}</strong> {isRu ? 'монохромное искажение, вдохновлённое эстетикой многократного копирования, наложения и деградации отпечатка, где форма постепенно растворяется в шуме и фактуре.' : 'monochrome distortion inspired by repeated copying, layering, and print degradation, where the form gradually dissolves into noise and texture.'}</p>
				<p><strong>{isRu ? 'Бубны —' : 'Diamonds —'}</strong> {isRu ? 'цветоканальное смещение с разъездом контуров, создающее эффект нестабильной цифровой регистрации и визуальной вибрации.' : 'color-channel displacement with separated contours, creating the effect of unstable digital registration and visual vibration.'}</p>
			</div>

			<p>{isRu ? 'В итоге проект представляет собой цельную визуальную систему, где традиционная типология игральной колоды соединяется с разными сценариями цифровой деформации. Каждая масть подчиняется собственной логике, а композиция, ритм и карточная сетка объединяют всю колоду в единый законченный объект.' : 'The final project is a coherent visual system in which the traditional structure of a playing-card deck is combined with several modes of digital deformation. Each suit follows its own logic, while the composition, rhythm, and card grid unify the deck into a complete object.'}</p>
		</section>
	</main>

	<CaseLightbox id="cards-lightbox" variant="single" label={isRu ? 'Увеличенная карта' : 'Enlarged card'} />
	<CasePagination
		previous={{ href: '/projects/product-design/shelfr/', label: 'Shelfr' }}
		next={{ href: '/projects/personal/republica/', label: isRu ? 'Шрифт Republica' : 'Republica Typeface' }}
	/>
	<ProjectFooter />
</BaseLayout>

<style>
	.cards-page {
		width: min(100%, 100rem);
		margin-inline: auto;
		padding: clamp(3rem, 7vw, 7rem) clamp(.75rem, 3vw, 3rem) clamp(5rem, 10vw, 10rem);
	}

	.cards-intro {
		display: grid;
		grid-template-columns: minmax(18rem, .85fr) minmax(25rem, .85fr) minmax(28rem, 1.25fr);
		grid-template-areas: "heading process copy";
		align-items: start;
		gap: clamp(2rem, 4vw, 5rem);
	}

	.cards-heading {
		grid-area: heading;
		position: sticky;
		top: 9rem;
	}

	.cards-copy { grid-area: copy; }
	.play-solitaire { display: inline-flex; align-items: center; gap: .8rem; margin-top: 2rem; padding: .9rem 1.15rem; border: 1px solid #555; border-radius: 4px; background: #262626; color: #fff; font-size: .85rem; text-decoration: none; }
	.play-solitaire:hover { background: #383838; border-color: #999; }
	.play-solitaire:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }

	h1 {
		margin: 0;
		font-size: var(--text-page-title);
		font-weight: var(--weight-page-title);
		line-height: var(--leading-page-title);
		letter-spacing: var(--tracking-page-title);
	}

	.cards-copy,
	.deck-copy {
		color: var(--color-muted);
		font-size: var(--text-body-lg);
		font-weight: 430;
		line-height: var(--leading-body-lg);
	}

	.cards-copy p,
	.deck-copy p { margin: 0 0 1.35rem; }
	.cards-copy p:last-child,
	.deck-copy p:last-child { margin-bottom: 0; }
	.cards-copy a { color: var(--color-text); text-underline-offset: .22em; text-decoration-thickness: 1px; }
	.cards-copy a:hover { color: #d8d8d8; }
	.suit-copy { margin-bottom: 2.5rem; }
	.suit-copy p { margin-bottom: .8rem; }
	.suit-copy p:first-child { margin-bottom: 1.35rem; color: var(--color-text); }
	.suit-copy strong { color: var(--color-text); font-weight: 700; }
	.cards-process { grid-area: process; display: grid; grid-template-columns: repeat(2, minmax(0, 12rem)); gap: 1rem; }
	.cards-process img { width: 100%; height: auto; display: block; }
	.process-button { min-width: 0; padding: 0; background: transparent; border: 0; cursor: zoom-in; }

	.back-card {
		width: clamp(5rem, 7vw, 7.2rem);
		margin: clamp(2rem, 4vw, 3.5rem) 0 0;
		padding: 0;
		display: block;
		background: transparent;
		border: 0;
		cursor: zoom-in;
	}

	.back-card :global(img),
	.card-button :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.deck { margin-top: clamp(5rem, 9vw, 9rem); }
	.deck-scroll {
		padding-bottom: .75rem;
		overflow-x: auto;
		overscroll-behavior-inline: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--color-muted) transparent;
	}

	.deck-grid {
		min-width: 60rem;
		display: grid;
		gap: clamp(.65rem, 1.1vw, 1.2rem);
	}

	.suit-row {
		display: grid;
		grid-template-columns: repeat(13, minmax(0, 1fr));
		gap: clamp(.3rem, .65vw, .7rem);
	}

	.deck-copy {
		width: min(100%, 52rem);
		margin: clamp(4rem, 8vw, 8rem) 0 0 auto;
	}

	.card-button {
		min-width: 0;
		padding: 0;
		display: block;
		background: transparent;
		border: 0;
		cursor: zoom-in;
		transition: transform .18s ease;
	}

	.card-button:hover { transform: translateY(-.25rem); }
	.card-button:focus-visible,
	.process-button:focus-visible,
	.back-card:focus-visible,
	.deck-scroll:focus-visible,
	.cards-copy a:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	@media (max-width: 1100px) {
		.cards-intro { grid-template-columns: minmax(16rem, .75fr) minmax(28rem, 1.25fr); grid-template-areas: "heading copy" "process copy"; }
	}

	@media (max-width: 800px) {
		.cards-page { padding-top: 3.5rem; }
		.cards-intro { grid-template-columns: 1fr; grid-template-areas: "heading" "process" "copy"; gap: 3rem; }
		.cards-heading { position: static; }
		.back-card { width: 6rem; }
		.cards-process { grid-template-columns: repeat(2, minmax(0, 9rem)); }
		.deck-grid { min-width: 72rem; }
	}

	@media (max-width: 440px) {
		.cards-process { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (prefers-reduced-motion: reduce) {
		.card-button { transition-duration: .01ms; }
	}
</style>
