---
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, localizedPath } from '../../lib/i18n';

const locale = getLocale(Astro.url.pathname);
const isRu = locale === 'ru';
---

<BaseLayout
	title={isRu ? 'Раздел в работе — Федор Юрецкий' : 'Section in progress — Fedor Jurecki'}
	description={isRu ? 'Новый раздел портфолио Федора Юрецкого находится в работе.' : 'A new section of Fedor Jurecki’s portfolio is in progress.'}
>
	<SiteHeader />
	<main class="placeholder-page">
		<section>
			<p>{isRu ? 'Портфолио' : 'Portfolio'}</p>
			<h1>{isRu ? <>Раздел<br />в работе</> : <>Section<br />in progress</>}</h1>
			<div class="placeholder-rule" aria-hidden="true"></div>
			<p class="placeholder-copy">{isRu ? 'Материалы для этого направления появятся позже.' : 'Work for this section will be added later.'}</p>
			<a href={localizedPath('/#work', locale)}>{isRu ? 'Вернуться к оглавлению' : 'Back to contents'} <span aria-hidden="true">←</span></a>
		</section>
	</main>
</BaseLayout>

<style>
	.placeholder-page { min-height: calc(100svh - 6rem); padding: clamp(1rem,3vw,3rem); display: grid; place-items: center; }
	.placeholder-page section { width: min(100%,52rem); padding: clamp(1.5rem,4vw,4rem); background: var(--color-panel); border: 1px solid var(--color-border); }
	.placeholder-page p { margin: 0; color: var(--color-muted); font-size: var(--text-label); font-weight: 700; letter-spacing: var(--tracking-label); text-transform: uppercase; }
	.placeholder-page h1 { margin: clamp(2.5rem,8vw,7rem) 0; font-size: var(--text-page-title); font-weight: var(--weight-page-title); line-height: var(--leading-page-title); letter-spacing: var(--tracking-page-title); }
	.placeholder-rule { height: 1px; margin-bottom: 1.5rem; background: var(--color-border); }
	.placeholder-page .placeholder-copy { max-width: 28rem; font-size: var(--text-body-sm); font-weight: 450; line-height: var(--leading-body-sm); letter-spacing: 0; text-transform: none; }
	.placeholder-page a { margin-top: 2rem; display: inline-flex; flex-direction: row-reverse; gap: .55rem; color: #fff; font-size: var(--text-action); font-weight: 700; text-decoration: none; }
	.placeholder-page a:hover { text-decoration: underline; text-underline-offset: .3rem; }
</style>
