---
import BackToTop from '../../../components/BackToTop.astro';
import CaseGallery from '../../../components/CaseGallery.astro';
import CaseLightbox from '../../../components/CaseLightbox.astro';
import ProjectFooter from '../../../components/ProjectFooter.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const filters = [
	{ id: 'all', label: 'Все работы' },
	{ id: 'research', label: 'Исследования' },
	{ id: 'reports', label: 'Отчёты' },
	{ id: 'social', label: 'Социальные данные' },
	{ id: 'science', label: 'Научные данные' },
	{ id: 'illustrative', label: 'Иллюстративная инфографика' },
];

const removedNumbers = new Set([1, 2, 6, 8, 10, 11, 28, 70, 72, 73, 74, 75, 76, 78, 80, 82]);
const illustrativeNumbers = new Set([9, 14, 15, 17, 19, 20, 21, 32, 40, 41, 42, 43, 44, 45, 46, 47, 59, 62, 63, 64]);
const curatedNumbers = [
	102, 17, 110, 83, 3, 91,
	103, 32, 111, 40, 84, 4,
	104, 47, 112, 92, 5, 89,
	105, 59, 113, 95, 14, 85,
	106, 114, 41, 86, 7, 107,
	115, 42, 87, 9, 108, 116,
	43, 88, 12, 109, 117, 44,
	90, 13, 118, 45, 62, 119,
	63, 120, 64, 121, 20, 21, 22, 46,
];
const curatedRank = new Map(curatedNumbers.map((number, index) => [number, index]));
const featuredNumbers = [32, 83, 17, 47, 63, 45];

const getGroup = (number: number) => {
	if (number >= 110) return 'Образовательная инфографика';
	if (number >= 102) return 'Бизнес-инфографика';
	if (number <= 11) return 'Годовые отчёты и международная статистика';
	if (number <= 21) return 'Социальные исследования и правовые реформы';
	if (number <= 39) return 'Гражданские исследования';
	if (number <= 69) return 'Социально-демографические исследования';
	if (number <= 90) return 'Научные и климатические данные';
	return 'Оценка образовательных программ';
};

const getCategories = (number: number) => {
	const categories = [];
	if (number >= 102 && number <= 109) categories.push('reports', 'illustrative');
	if (number >= 110) categories.push('research', 'illustrative');
	if (number <= 11 || number === 22) categories.push('reports');
	if ((number >= 12 && number <= 39) || number >= 91) categories.push('research');
	if (number >= 12 && number <= 69) categories.push('social');
	if (number >= 70 && number <= 90) categories.push('science');
	if (illustrativeNumbers.has(number)) categories.push('illustrative');
	return categories;
};

const allImages = Array.from({ length: 121 }, (_, index) => {
	const number = index + 1;
	return {
		number,
		src: `/portfolio/infographics/graphic-${String(number).padStart(3, '0')}.webp`,
		group: getGroup(number),
		categories: getCategories(number),
	};
})
	.filter(({ number }) => !removedNumbers.has(number))
	.sort((a, b) => {
		const aRank = curatedRank.get(a.number);
		const bRank = curatedRank.get(b.number);
		if (aRank !== undefined && bRank !== undefined) return aRank - bRank;
		if (aRank !== undefined) return -1;
		if (bRank !== undefined) return 1;
		return a.number - b.number;
	});
const featuredImages = featuredNumbers.map((number) => allImages.find((image) => image.number === number)!);
const galleryImages = allImages.filter(({ number }) => !featuredNumbers.includes(number));

const initialGalleryCount = 24;
---

<BaseLayout
	title="Инфографика — Федор Юрецкий"
	description="Инфографика и визуализация данных: диаграммы, схемы, карты и исследовательские материалы."
>
	<SiteHeader />

	<main>
		<section class="project-intro">
			<div class="intro-heading">
				<h1>Инфографика</h1>
				<div class="tags" aria-label="Фильтры галереи">
					{filters.map(({ id, label }) => (
						<button
							class:list={['format-filter', { active: id === 'all' }]}
							type="button"
							data-filter={id}
							aria-pressed={id === 'all' ? 'true' : 'false'}
						>
							{label}
						</button>
					))}
				</div>
			</div>
			<p>Превращаю сухие данные в ясную и выразительную графику: рисую вручную в Illustrator, работаю с RAWGraphs. Могу подсветить главное или сохранить максимально честную репрезентацию — в зависимости от задачи.</p>
		</section>

		<section class="featured-grid" aria-label="Избранные работы">
			{featuredImages.map(({ src, group }, index) => (
				<button
					class="featured-work"
					type="button"
					data-lightbox-target="case-gallery-lightbox"
					aria-label={`Увеличить: ${group}`}
				>
					<ResponsiveImage
						src={src}
						alt={`${group}: избранный пример инфографики`}
						sizes="(max-width: 760px) 100vw, 88vw"
						loading={index < 2 ? 'eager' : 'lazy'}
						fetchpriority={index === 0 ? 'high' : 'auto'}
					/>
				</button>
			))}
		</section>

		<CaseGallery
			label="Галерея инфографики"
			title=""
			showHeader={false}
			items={galleryImages.map(({ src, group, categories }, index) => ({
				caption: group,
				number: String(index + 1).padStart(3, '0'),
				categories,
				hidden: index >= initialGalleryCount,
				images: [{ src, alt: `${group}: пример инфографики ${index + 1}` }],
			}))}
			variant="numbered"
			lightboxId="case-gallery-lightbox"
		>
			<div slot="toolbar" class="gallery-toolbar">
				<p class="gallery-status" aria-live="polite">Показано {initialGalleryCount} из {galleryImages.length}</p>
				<button class="gallery-reset" type="button" hidden>Сбросить фильтр</button>
			</div>
			<div slot="actions" class="gallery-actions">
				<button class="gallery-more" type="button">Показать ещё</button>
			</div>
		</CaseGallery>

		<CaseLightbox id="case-gallery-lightbox" variant="single" label="Увеличенное изображение инфографики" />
		<ProjectFooter />
	</main>

	<BackToTop />

	<script>
		const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('.format-filter')];
		const galleryItems = [...document.querySelectorAll<HTMLElement>('[data-gallery-item]')];
		const galleryStatus = document.querySelector<HTMLElement>('.gallery-status');
		const galleryMore = document.querySelector<HTMLButtonElement>('.gallery-more');
		const galleryReset = document.querySelector<HTMLButtonElement>('.gallery-reset');
		const pageSize = 24;
		let activeFilter = 'all';
		let visibleCount = pageSize;

		const updateGallery = () => {
			const matchingItems = galleryItems.filter((item) =>
				activeFilter === 'all' || item.dataset.categories?.split(' ').includes(activeFilter)
			);

			galleryItems.forEach((item) => {
				const matchingIndex = matchingItems.indexOf(item);
				item.hidden = matchingIndex === -1 || matchingIndex >= visibleCount;
			});

			const shownCount = Math.min(visibleCount, matchingItems.length);
			if (galleryStatus) galleryStatus.textContent = `Показано ${shownCount} из ${matchingItems.length}`;
			if (galleryMore) galleryMore.hidden = shownCount >= matchingItems.length;
			if (galleryReset) galleryReset.hidden = activeFilter === 'all';
		};

		const setFilter = (filter: string) => {
			activeFilter = filter;
			visibleCount = pageSize;
			filterButtons.forEach((button) => {
				const isActive = button.dataset.filter === activeFilter;
				button.classList.toggle('active', isActive);
				button.setAttribute('aria-pressed', String(isActive));
			});
			updateGallery();
		};

		filterButtons.forEach((button) => {
			button.addEventListener('click', () => setFilter(button.dataset.filter ?? 'all'));
		});
		galleryMore?.addEventListener('click', () => {
			visibleCount += pageSize;
			updateGallery();
		});
		galleryReset?.addEventListener('click', () => setFilter('all'));
		updateGallery();
	</script>
</BaseLayout>

<style>
	main { padding: 0 clamp(1.25rem,4vw,4.5rem) clamp(2rem,5vw,5rem); }
	.project-intro { width: 100%; max-width: 88rem; margin: 0 auto; padding: clamp(4rem,8vw,7rem) 0 clamp(4rem,7vw,7rem); display: grid; grid-template-columns: minmax(0,1fr) minmax(20rem,.52fr); gap: clamp(2rem,7vw,8rem); align-items: end; }
	.project-intro > *,.gallery-toolbar > * { min-width: 0; }
	h1 { margin: 0; font-size: var(--text-page-title); font-weight: var(--weight-page-title); line-height: var(--leading-page-title); letter-spacing: var(--tracking-page-title); }
	.project-intro p { max-width: 42rem; margin: 0; color: var(--color-muted); font-size: var(--text-page-intro); font-weight: var(--weight-page-intro); line-height: var(--leading-page-intro); }
	.tags { max-width: 52rem; margin-top: 1.5rem; display: flex; flex-wrap: nowrap; gap: .45rem; }
	.format-filter { min-height: 2.75rem; padding: .55rem .75rem; color: #111; background: #fff; border: 1px solid #1113; border-radius: var(--radius-pill); font-size: .7rem; font-weight: 700; line-height: 1.2; white-space: nowrap; cursor: pointer; transition: color .2s ease, background .2s ease, border-color .2s ease; }
	.format-filter:hover { border-color: #111; }
	.format-filter.active { color: #fff; background: var(--color-accent); border-color: var(--color-accent); }
	.format-filter:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
	.featured-grid { width: 100%; max-width: 88rem; margin: 0 auto clamp(4rem,8vw,8rem); display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(.75rem,1.5vw,1.5rem); align-items: start; }
	.featured-work { width: 100%; padding: clamp(.35rem,.7vw,.65rem); display: block; background: #efefec; border: 1px solid rgba(17,17,17,.12); border-radius: var(--radius-thumb); cursor: zoom-in; transition: transform .25s ease,box-shadow .25s ease; }
	.featured-work:first-child,.featured-work:nth-child(4) { grid-column: 1 / -1; }
	.featured-work:hover { transform: translateY(-.25rem); box-shadow: 0 1.2rem 2.5rem rgba(0,0,0,.12); }
	.featured-work:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
	.featured-work img { width: 100%; height: auto; display: block; }
	.gallery-toolbar { min-height: 2.5rem; margin-bottom: 1.2rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-bottom: 1px solid #1112; }
	.gallery-status { margin: 0; color: #666; font-size: .65rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
	.gallery-reset { padding: .4rem 0; color: var(--color-accent); background: transparent; border: 0; font-size: .7rem; font-weight: 750; cursor: pointer; }
	.gallery-actions { padding: clamp(2rem,4vw,4rem) 0 0; display: flex; justify-content: center; }
	.gallery-more { min-width: 12rem; min-height: 3.25rem; padding: .8rem 1.4rem; color: #fff; background: #0b0b0b; border: 0; border-radius: var(--radius-pill); font-weight: 750; cursor: pointer; transition: background .2s ease, transform .2s ease, box-shadow .2s ease; }
	.gallery-more:hover { background: var(--color-accent); transform: translateY(var(--cta-hover-lift)); box-shadow: var(--cta-hover-shadow); }
	.gallery-more:active { transform: translateY(var(--cta-active-lift)); box-shadow: none; }
	.gallery-more:focus-visible,.gallery-reset:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	@media (max-width: 1100px) {
		.tags { flex-wrap: wrap; }
	}

	@media (max-width: 760px) {
		main { padding-inline: 1rem; }
		.project-intro { padding: 3.5rem 0 4rem; grid-template-columns: minmax(0,1fr); gap: 1.5rem; }
		.tags { flex-wrap: wrap; }
		.format-filter { padding: .55rem .8rem; font-size: .74rem; line-height: 1.35; }
		.featured-grid { grid-template-columns: minmax(0,1fr); margin-bottom: 4rem; }
		.featured-work:first-child,.featured-work:nth-child(4) { grid-column: auto; }
		.gallery-status,.gallery-reset { font-size: .72rem; line-height: 1.45; }
	}

	@media (prefers-reduced-motion: reduce) {
		* { transition-duration: .01ms !important; }
	}
</style>
