---
import BackToTop from '../../../components/BackToTop.astro';
import CaseGallery from '../../../components/CaseGallery.astro';
import CaseLightbox from '../../../components/CaseLightbox.astro';
import CasePagination from '../../../components/CasePagination.astro';
import CaseResults from '../../../components/CaseResults.astro';
import ProjectFooter from '../../../components/ProjectFooter.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const gallery = [
	['identity-mobility.webp', 'Множественность идентичностей · Социальная мобильность'],
	['identity-attitudes-1.webp', 'Множественность идентичностей · Сравнение показателей'],
	['identity-attitudes-2.webp', 'Множественность идентичностей · Визуализация ответов'],
	['legal-title.webp', 'Правовые реформы · Титульная страница'],
	['legal-illustration-1.webp', 'Правовые реформы · Образование и правопорядок'],
	['legal-data-3.webp', 'Правовые реформы · Данные исследования'],
	['legal-data-4.webp', 'Правовые реформы · Сравнение показателей'],
	['citizenship-illustration-kz.webp', 'Формирование гражданственности · Визуальная вставка'],
	['citizenship-data-kz-2.webp', 'Формирование гражданственности · Данные опроса'],
	['citizenship-data-ru-2.webp', 'Формирование гражданственности · Аналитическая полоса'],
	['citizenship-data-ru-3.webp', 'Формирование гражданственности · Результаты исследования'],
];
---

	<BaseLayout
		title="KIPD — Федор Юрецкий"
		description="Казахстанский институт общественного развития: дизайн, вёрстка и инфографика аналитических докладов на казахском и русском языках."
	>
		<SiteHeader />

		<main>
			<section class="project-hero">
				<p class="eyebrow">Многостраничные издания · Серия исследований</p>
				<div class="hero-row">
					<h1>КИОР<br /><span class="title-accent">KIPD</span></h1>
					<div class="summary">
						<p>В рамках трёх исследовательских проектов KIPD я самостоятельно вёл визуальное направление изданий: от разработки общей концепции и арт-дирекшена до финальной вёрстки и подготовки материалов к публикации. Для серии была создана единая редакционная система — модульные сетки, типографическая иерархия, принципы работы с изображениями и структура подачи больших объёмов аналитического материала.</p>
						<p>Отдельной частью работы стала визуализация данных. Я разработал инфографику, диаграммы и способы представления результатов исследований, адаптируя их под содержание каждого доклада и сохраняя общую визуальную логику серии. В результате три разных по тематике исследования получили самостоятельный характер, оставаясь частью одной последовательной дизайн-системы.</p>
						<p>Также я вёл журнал KIPD: разрабатывал обложки, выполнял вёрстку и инфографику.</p>
					</div>
				</div>
			</section>

			<figure class="cover-stage">
				<div class="cover cover-left"><ResponsiveImage src="/portfolio/kipd/identity-cover.webp" alt="Обложка доклада КИОР о множественности идентичностей" sizes="(max-width: 700px) 32vw, 24vw" loading="eager" /></div>
				<div class="cover cover-main"><ResponsiveImage src="/portfolio/kipd/legal-cover.webp" alt="Обложка доклада КИОР о правовых реформах" sizes="(max-width: 700px) 36vw, 28vw" loading="eager" fetchpriority="high" /></div>
				<div class="cover cover-right"><ResponsiveImage src="/portfolio/kipd/citizenship-cover.webp" alt="Обложка доклада КИОР о формировании гражданственности" sizes="(max-width: 700px) 32vw, 24vw" loading="eager" /></div>
			</figure>

			<section class="showcase showcase-dark" id="case-series" data-case-section>
				<div class="identity-layout">
					<div class="identity-pages">
						<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/identity-demography-1.webp" data-caption="Множественность идентичностей · Демография"><ResponsiveImage src="/portfolio/kipd/identity-demography-1.webp" alt="Инфографика демографического профиля исследования" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
						<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/identity-demography-2.webp" data-caption="Множественность идентичностей · Социальный профиль"><ResponsiveImage src="/portfolio/kipd/identity-demography-2.webp" alt="Инфографика социального профиля исследования" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
						<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/identity-profile-1.webp" data-caption="Множественность идентичностей · Профиль респондентов"><ResponsiveImage src="/portfolio/kipd/identity-profile-1.webp" alt="Инфографика профиля респондентов" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
						<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/identity-profile-2.webp" data-caption="Множественность идентичностей · Период проживания"><ResponsiveImage src="/portfolio/kipd/identity-profile-2.webp" alt="Инфографика периода проживания респондентов" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
					</div>
				</div>
			</section>

			<section class="legal-section" id="case-system" data-case-section>
				<div class="legal-stage">
					<div class="legal-spread">
						<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/legal-section-1.webp" data-caption="Правовые реформы · Раздел исследования"><ResponsiveImage src="/portfolio/kipd/legal-section-1.webp" alt="Вводная полоса раздела о правовых реформах" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
						<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/legal-section-2.webp" data-caption="Правовые реформы · Аналитическая полоса"><ResponsiveImage src="/portfolio/kipd/legal-section-2.webp" alt="Аналитическая полоса доклада о правовых реформах" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
						<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/legal-data-1.webp" data-caption="Правовые реформы · Диаграммы"><ResponsiveImage src="/portfolio/kipd/legal-data-1.webp" alt="Диаграммы исследования правовых реформ" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
						<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/legal-data-2.webp" data-caption="Правовые реформы · Сравнение данных"><ResponsiveImage src="/portfolio/kipd/legal-data-2.webp" alt="Сравнительные диаграммы исследования правовых реформ" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
					</div>
				</div>
			</section>

			<section class="citizenship showcase-dark">
				<div class="citizenship-grid">
					<figure class="citizen-title"><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/citizenship-title-kz.webp" data-caption="Формирование гражданственности · Казахская версия"><ResponsiveImage src="/portfolio/kipd/citizenship-title-kz.webp" alt="Титульная страница казахской версии доклада" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
					<figure class="citizen-data"><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/citizenship-data-kz-1.webp" data-caption="Формирование гражданственности · Данные исследования"><ResponsiveImage src="/portfolio/kipd/citizenship-data-kz-1.webp" alt="Инфографика казахской версии исследования" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
					<figure class="citizen-title"><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/citizenship-title-ru.webp" data-caption="Формирование гражданственности · Русская версия"><ResponsiveImage src="/portfolio/kipd/citizenship-title-ru.webp" alt="Титульная страница русской версии доклада" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
					<figure class="citizen-data"><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/kipd/citizenship-data-ru-1.webp" data-caption="Формирование гражданственности · Аналитическая полоса"><ResponsiveImage src="/portfolio/kipd/citizenship-data-ru-1.webp" alt="Инфографика русской версии исследования" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
				</div>
			</section>

			<section class="result" id="case-result" data-case-section>
				<div class="rich-text">
					<h2>Три темы на казахском и русском.</h2>
					<p>Я подготовил доклады о множественности идентичностей, правовых реформах и формировании гражданственности на казахском и русском языках. Для каждого исследования я адаптировал шаблоны длинных текстов, таблиц, диаграмм и иллюстраций под тему и объём материала. Все версии я подготовил к публикации.</p>
					<CaseResults items={[
						['3 темы', 'идентичности · реформы · гражданственность'],
						['2 версии', 'казахский и русский языки'],
						['Шаблоны', 'для текста, таблиц и диаграмм'],
					]} />
				</div>
			</section>

			<CaseGallery
				label="Галерея"
				title=""
				items={gallery.map(([file, caption]) => ({
					caption,
					images: [{
						src: `/portfolio/kipd/${file}`,
						alt: caption,
						width: file.startsWith('legal') ? 1240 : 1261,
						height: file.startsWith('legal') ? 1754 : 1800,
					}],
				}))}
				variant="pages"
				lightboxId="case-gallery-lightbox"
				showHeader={false}
			>
				<h2 slot="toolbar" class="gallery-only-title">ГАЛЕРЕЯ</h2>
			</CaseGallery>
			<CaseLightbox id="case-gallery-lightbox" variant="single" label="Увеличенная страница проекта КИОР" />

			<CasePagination
				previous={{ href: '/projects/publications/iofs', label: 'ИОПБ / IOFS' }}
				next={{ href: '/projects/publications/unesco', label: 'ЮНЕСКО' }}
			/>
			<ProjectFooter />
		</main>
		<BackToTop />

	</BaseLayout>

<style>
	header { height:6rem; padding:0 clamp(1.25rem,4vw,4.5rem); display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); align-items:center; }
	.back { display:flex; align-items:center; gap:.7rem; width:max-content; font-size:var(--text-navigation); font-weight:750; text-decoration:none; }
	.back span { width:2.25rem; height:2.25rem; display:grid; place-items:center; border:1px solid #1113; border-radius:50%; transition:transform .2s ease; }
	.back:hover span { transform:translateX(-.25rem); }
	.brand { width:clamp(7.8rem,10vw,10rem); line-height:0; }
	.brand img { display:block; width:100%; }
	.page-count { justify-self:end; color:#777; font-size:var(--text-caption); font-weight:750; line-height:var(--leading-caption); letter-spacing:var(--tracking-caption); text-transform:uppercase; }
	main { padding:0 clamp(1.25rem,4vw,4.5rem) clamp(2rem,5vw,5rem); }
	.project-hero { width:100%; max-width:88rem; margin:0 auto; padding:clamp(4rem,8vw,7rem) 0 clamp(4rem,7vw,7rem); }
	.eyebrow { margin:0; color:var(--color-accent); font-size:var(--text-label); font-weight:800; line-height:var(--leading-label); letter-spacing:var(--tracking-label); text-transform:uppercase; }
	.hero-row { display:grid; grid-template-columns:minmax(0,1fr) minmax(20rem,.42fr); gap:4rem; align-items:start; }
	header>*,.hero-row>*,.cover-stage>*,.identity-pages>*,.legal-spread>*,.citizenship-grid>* { min-width:0; }
	h1 { margin:0; font-size:var(--text-page-title); font-weight:var(--weight-page-title); line-height:var(--leading-page-title); letter-spacing:var(--tracking-page-title); }
	h1 .title-accent { display:block; color:var(--color-accent); font-family:inherit; font-size:1em; font-style:normal; font-weight:inherit; line-height:inherit; letter-spacing:inherit; overflow-wrap:anywhere; }
	.summary { color:#565656; font-size:var(--text-page-intro); font-weight:var(--weight-page-intro); line-height:var(--leading-page-intro); }
	.summary p { margin:0; }
	.summary p+p { margin-top:1.25rem; }
	.cover-stage { width:100%; max-width:88rem; min-height:clamp(36rem,62vw,62rem); margin:0 auto; padding:clamp(2rem,5vw,5rem); display:flex; justify-content:center; align-items:center; gap:clamp(.7rem,2.2vw,2.2rem); position:relative; overflow:hidden; background:#0b0b0b; border-radius:var(--radius-shell); }
	.cover { flex:0 1 25%; position:relative; z-index:1; filter:drop-shadow(0 2rem 2rem #0009); }
	.cover-main { flex-basis:30%; z-index:2; transform:translateY(-2%); }
	.cover-left { transform:rotate(-7deg) translateY(5%); }
	.cover-right { transform:rotate(7deg) translateY(5%); }
	.cover img { display:block; width:100%; height:auto; border-radius:var(--radius-thumb); }
	.rich-text h2 { margin:0; font-size:var(--text-display-section); line-height:var(--leading-display-section); letter-spacing:var(--tracking-display-section); }
	.rich-text p { max-width:52rem; margin:1.7rem 0 0; color:#5a5a5a; font-size:var(--text-body-lg); line-height:var(--leading-body-lg); }
	.showcase-dark { width:100%; max-width:88rem; margin:0 auto; padding:clamp(2rem,4vw,4.5rem); color:#fff; background:#0b0b0b; border-radius:var(--radius-shell); }
	.zoom-trigger { display:block; width:100%; padding:0; overflow:hidden; color:inherit; background:transparent; border:0; cursor:zoom-in; }
	.zoom-trigger img { display:block; width:100%; height:auto; transition:transform .35s ease; }
	.zoom-trigger:hover img { transform:scale(1.015); }
	.zoom-trigger:focus-visible { outline:var(--focus-ring-width) solid var(--focus-ring-color); outline-offset:var(--focus-ring-offset); }
	.identity-layout figure,.legal-stage figure,.citizenship-grid figure { margin:0; }
	.identity-pages figure,.legal-spread,.citizenship-grid figure { padding:clamp(.4rem,.8vw,.7rem); background:#fff; border-radius:var(--radius-thumb); box-shadow:0 1.5rem 3rem #0007; }
	.identity-pages { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.6rem; align-items:start; }
	.identity-pages figure:nth-child(even) { margin-top:2.5rem; }
	.legal-section { width:100%; max-width:88rem; margin:0 auto; padding:clamp(2rem,4vw,4rem) 0; }
	.legal-stage { padding:clamp(1.25rem,3vw,3rem); background:#0b0b0b; border-radius:var(--radius-shell); }
	.legal-spread { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.25rem; }
	.citizenship { margin-top:0; }
	.citizenship-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; align-items:center; }
	.result { width:100%; max-width:82rem; margin:0 auto; padding:clamp(8rem,14vw,14rem) 0 clamp(3rem,5vw,5rem); }
	.gallery-only-title { margin:0 0 clamp(3rem,6vw,6rem); font-size:var(--text-display-section); line-height:var(--leading-display-section); letter-spacing:var(--tracking-display-section); }

	@media(max-width:980px){
		.hero-row { grid-template-columns:minmax(0,1fr); gap:2rem; }
		.summary { max-width:43rem; }
	}

	@media(max-width:700px){
		header { height:5rem; padding-inline:1rem; grid-template-columns:minmax(0,1fr) auto; }
		.brand { display:none; }
		main { padding-inline:1rem; }
		.project-hero { padding:3.5rem 0 4rem; }
		.cover-stage { min-height:29rem; padding:1.2rem; gap:.35rem; }
		.cover { flex-basis:29%; }
		.cover-main { flex-basis:34%; }
		.showcase-dark,.legal-stage { padding:1.25rem; }
		.identity-pages { grid-template-columns:repeat(2,minmax(0,1fr)); }
		.identity-pages figure:nth-child(even) { margin-top:1rem; }
		.legal-section { padding:2rem 0; }
		.legal-spread { grid-template-columns:repeat(2,minmax(0,1fr)); }
		.citizenship-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
		.result { padding:7rem 0 3rem; }
	}

	@media(max-width:440px){
		.back span { width:2rem; height:2rem; }
		.page-count { max-width:6rem; text-align:right; line-height:1.35; }
		.cover-stage { min-height:24rem; }
	}

	@media(prefers-reduced-motion:reduce){ html{scroll-behavior:auto} *{transition-duration:.01ms!important} }
</style>
