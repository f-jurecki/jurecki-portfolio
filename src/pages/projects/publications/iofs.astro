---
import BackToTop from '../../../components/BackToTop.astro';
import CaseGallery from '../../../components/CaseGallery.astro';
import CaseLightbox from '../../../components/CaseLightbox.astro';
import CasePagination from '../../../components/CasePagination.astro';
import CaseResults from '../../../components/CaseResults.astro';
import ProjectFooter from '../../../components/ProjectFooter.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocale } from '../../../lib/i18n';

const isRu = getLocale(Astro.url.pathname) === 'ru';

const gallery = [
	['gallery-annual-a1.webp', 'gallery-annual-a2.webp', isRu ? 'Годовой отчёт · Раздел 01' : 'Annual Report · Section 01', 'left page', 'right page'],
	['gallery-annual-b1.webp', 'gallery-annual-b2.webp', isRu ? 'Годовой отчёт · Раздел 02' : 'Annual Report · Section 02', 'left page', 'right page'],
	['gallery-fsh22-a2.webp', 'gallery-fsh22-a1.webp', isRu ? 'Food Security Hub · Выпуск 22' : 'Food Security Hub · Issue 22', 'left page', 'right page'],
	['gallery-fsh22-b1.webp', 'gallery-fsh22-b2.webp', isRu ? 'Food Security Hub · Выпуск 22' : 'Food Security Hub · Issue 22', 'left page', 'right page'],
	['gallery-fsh23-a1.webp', 'gallery-fsh23-a2.webp', isRu ? 'Food Security Hub · Выпуск 23' : 'Food Security Hub · Issue 23', 'left page', 'right page'],
	['gallery-fsh23-b1.webp', 'gallery-fsh23-b2.webp', isRu ? 'Food Security Hub · Выпуск 23' : 'Food Security Hub · Issue 23', 'left page', 'right page'],
].map(([left, right, caption, leftAlt, rightAlt]) => ({
	caption,
	images: [
		{ src: `/portfolio/iofs/${left}`, alt: `${caption}: ${leftAlt}` },
		{ src: `/portfolio/iofs/${right}`, alt: `${caption}: ${rightAlt}` },
	],
}));
---

	<BaseLayout
		title={isRu ? 'IOFS — Федор Юрецкий' : 'IOFS — Editorial Design by Fedor Jurecki'}
	description={isRu ? 'IOFS — дизайн и вёрстка годового отчёта, ежеквартального журнала Food Security Hub и других многостраничных материалов.' : 'Editorial design and layout for the IOFS annual report, Food Security Hub publication, and other multi-page materials.'}
	>
		<SiteHeader />

		<main>
			<section class="project-hero">
				<p class="eyebrow">{isRu ? 'Многостраничные издания · Редакционный дизайн' : 'Multi-page publications · Editorial design'}</p>
				<div class="hero-row">
					<h1>{isRu ? <>ИОПБ<br /><span class="title-accent">IOFS</span></> : 'IOFS'}</h1>
					<div class="summary">
						<p>{isRu ? 'В работе над печатными материалами ИОПБ я выступаю ведущим дизайнером и отвечаю за развитие визуального направления организации. Опираясь на ранее созданные материалы, я развиваю существующий стиль, адаптирую его под новые форматы и задачи и поддерживаю визуальную целостность публикаций.' : 'I serve as lead designer for IOFS print and editorial materials and am responsible for developing the organization’s visual direction. Building on earlier work, I evolve the existing style, adapt it to new formats and needs, and maintain visual consistency across publications.'}</p>
						<p>{isRu ? 'Последние отчёты, выпуски Food Security Hub и другие редакционные материалы были разработаны и арт-директированы мной: от структуры и вёрстки до инфографики и отдельных визуальных решений. При работе с новыми публикациями я сохраняю преемственность существующего визуального языка, постепенно расширяя и систематизируя его.' : 'The latest annual reports, Food Security Hub issues, and other editorial materials were designed and art-directed by me, from structure and layout to infographics and individual visual solutions. With each new publication, I preserve continuity with the established visual language while gradually expanding and systematizing it.'}</p>
					</div>
				</div>
			</section>

			<figure class="cover-stage">
				<div class="cover cover-small"><ResponsiveImage src="/portfolio/iofs/fsh22-cover.webp" alt={isRu ? 'Обложка журнала Food Security Hub, выпуск 22' : 'Food Security Hub publication cover, edition 22'} sizes="(max-width: 700px) 32vw, 24vw" loading="eager" /></div>
				<div class="cover cover-main"><ResponsiveImage src="/portfolio/iofs/annual-cover.webp" alt={isRu ? 'Обложка годового отчёта IOFS за 2025 год' : 'IOFS 2025 annual report cover'} sizes="(max-width: 700px) 36vw, 28vw" loading="eager" fetchpriority="high" /></div>
				<div class="cover cover-small"><ResponsiveImage src="/portfolio/iofs/fsh23-cover.webp" alt={isRu ? 'Обложка журнала Food Security Hub, выпуск 23' : 'Food Security Hub publication cover, edition 23'} sizes="(max-width: 700px) 32vw, 24vw" loading="eager" /></div>
			</figure>

			<section class="overview section-grid" id="case-task" data-case-section>
				<p class="section-label">{isRu ? 'Задача' : 'Scope'}</p>
				<div class="rich-text">
					<h2>{isRu ? <>Журнал — раз в квартал.<br />Годовой отчёт — раз в год.</> : <>Quarterly publication.<br />Annual report once a year.</>}</h2>
					<p>{isRu ? 'Каждый квартал я верстаю новый выпуск Food Security Hub, раз в год — годовой отчёт о программах, показателях и географии работы IOFS.' : 'Every quarter, I design a new edition of Food Security Hub; once a year, I produce the annual report covering IOFS programs, performance indicators, and geographic reach.'}</p>
					<p>{isRu ? 'Также оформляю материалы для мероприятий: баннеры, раздаточные материалы и роллапы. Для каждого формата адаптирую общую визуальную систему под содержание и задачу.' : 'I also design materials for events, including banners, handouts, and roll-up displays. For each format, I adapt the shared visual system to the specific content and purpose.'}</p>
				</div>
			</section>

			<section class="showcase showcase-sky" id="case-report" data-case-section>
				<div class="spread-pair">
					<ResponsiveImage src="/portfolio/iofs/annual-glance-1.webp" alt={isRu ? 'Разворот IOFS at a Glance: миссия и цели' : 'IOFS at a Glance spread: mission and goals'} sizes="(max-width: 700px) 50vw, 44vw" />
					<ResponsiveImage src="/portfolio/iofs/annual-glance-2.webp" alt={isRu ? 'Разворот IOFS at a Glance: ключевые показатели 2025 года' : 'IOFS at a Glance spread: 2025 key figures'} sizes="(max-width: 700px) 50vw, 44vw" />
				</div>
			</section>

			<div class="spread-frame spread-frame-light">
				<div class="spread-pair">
					<ResponsiveImage src="/portfolio/iofs/annual-system-1.webp" alt={isRu ? 'Инфографика результатов официальных миссий IOFS' : 'Infographic showing the results of IOFS official missions'} sizes="(max-width: 700px) 50vw, 44vw" />
					<ResponsiveImage src="/portfolio/iofs/annual-system-2.webp" alt={isRu ? 'Инфографика стран-участниц IOFS' : 'Infographic showing IOFS member states'} sizes="(max-width: 700px) 50vw, 44vw" />
				</div>
			</div>

			<section class="covers-section">
				<div class="showcase-head showcase-head-light"><span>{isRu ? 'Серия' : 'Series'}</span><h2>Food Security<br />Hub</h2><p>{isRu ? 'Обложки сохраняют узнаваемую композицию, а аграрная фотография задаёт тему каждого выпуска.' : 'The covers retain a recognizable composition, while agricultural photography sets the theme for each issue.'}</p></div>
				<div class="covers-grid">
					<ResponsiveImage src="/portfolio/iofs/fsh22-cover.webp" alt={isRu ? 'Обложка Food Security Hub №22' : 'Food Security Hub issue 22 cover'} sizes="(max-width: 700px) 50vw, 28vw" />
					<ResponsiveImage src="/portfolio/iofs/fsh23-cover.webp" alt={isRu ? 'Обложка Food Security Hub №23' : 'Food Security Hub issue 23 cover'} sizes="(max-width: 700px) 50vw, 28vw" />
				</div>
			</section>

			<section class="journal-section" id="case-journal" data-case-section>
				<div class="spread-frame spread-frame-white">
					<div class="spread-pair">
						<ResponsiveImage src="/portfolio/iofs/fsh23-feature-1.webp" alt={isRu ? 'Текстовая полоса Food Security Hub' : 'Food Security Hub editorial page'} sizes="(max-width: 700px) 50vw, 44vw" />
						<ResponsiveImage src="/portfolio/iofs/fsh23-feature-2.webp" alt={isRu ? 'Полоса Food Security Hub с крупной аграрной фотографией' : 'Food Security Hub page with a large agricultural photograph'} sizes="(max-width: 700px) 50vw, 44vw" />
					</div>
				</div>
			</section>

			<section class="news-section">
				<div class="news-grid">
					<ResponsiveImage src="/portfolio/iofs/fsh23-news-1.webp" alt={isRu ? 'Новостная полоса журнала IOFS' : 'IOFS publication news page'} sizes="(max-width: 700px) 50vw, 25vw" />
					<ResponsiveImage src="/portfolio/iofs/fsh23-news-2.webp" alt={isRu ? 'Новостная полоса журнала IOFS' : 'IOFS publication news page'} sizes="(max-width: 700px) 50vw, 25vw" />
					<ResponsiveImage src="/portfolio/iofs/fsh23-chronicle-1.webp" alt={isRu ? 'Фотохроника международных встреч IOFS' : 'Photo chronicle of IOFS international meetings'} sizes="(max-width: 700px) 50vw, 25vw" />
					<ResponsiveImage src="/portfolio/iofs/fsh23-chronicle-2.webp" alt={isRu ? 'Фотохроника мероприятий IOFS' : 'Photo chronicle of IOFS events'} sizes="(max-width: 700px) 50vw, 25vw" />
				</div>
			</section>

			<section class="closing-section section-grid" id="case-result" data-case-section>
				<p class="section-label">{isRu ? 'Результат' : 'Result'}</p>
				<div>
					<div class="rich-text"><h2>{isRu ? 'Годовой отчёт и журнал на постоянном сопровождении.' : 'Ongoing design support for the annual report and publication.'}</h2><p>{isRu ? 'Я веду дизайн и вёрстку годового отчёта и периодического журнала Food Security Hub. Основной язык вёрстки — английский: я собираю длинные тексты, таблицы, фотографии и инфографику в единую систему, которую можно масштабировать на новые материалы.' : 'I lead the design and layout of the annual report and the recurring Food Security Hub publication. English is the primary working language: I bring long-form text, tables, photography, and infographics into a single system that can scale across new materials.'}</p><p>{isRu ? 'Журнал находится на моём постоянном сопровождении. Для каждого выпуска я обновляю содержание и данные, сохраняю преемственность серии и развиваю дизайн-систему по мере появления новых задач.' : 'The publication remains under my ongoing design support. For each edition, I update the content and data, preserve continuity across the series, and develop the design system as new needs emerge.'}</p></div>
					<CaseResults items={[
						[isRu ? '2 формата' : '2 formats', isRu ? 'годовой отчёт и журнал' : 'annual report and publication'],
						[isRu ? 'Английский' : 'English', isRu ? 'основной язык вёрстки' : 'primary layout language'],
						[isRu ? 'Сопровождение' : 'Ongoing support', isRu ? 'новые выпуски Food Security Hub' : 'new Food Security Hub issues'],
					]} />
				</div>
			</section>

			<CaseGallery
				label={isRu ? 'Галерея' : 'Gallery'}
				title=""
				items={gallery}
				variant="spread"
				lightboxId="case-gallery-lightbox"
				showHeader={false}
			>
				<h2 slot="toolbar" class="gallery-only-title">{isRu ? 'ГАЛЕРЕЯ' : 'GALLERY'}</h2>
			</CaseGallery>
			<CaseLightbox id="case-gallery-lightbox" variant="spread" label={isRu ? 'Увеличенный разворот' : 'Enlarged spread'} />

			<CasePagination
				previous={{ href: '/projects/vibecoding/sequence/', label: 'Sequence' }}
				next={{ href: '/projects/publications/kipd', label: isRu ? 'КИОР / KIPD' : 'KIPD' }}
			/>
			<ProjectFooter />
		</main>
		<BackToTop />
	</BaseLayout>

<style>
	header { height: 6rem; padding: 0 clamp(1.25rem,4vw,4.5rem); display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center; }
	.back { display: flex; align-items: center; gap: .7rem; width: max-content; font-size: var(--text-navigation); font-weight: 750; text-decoration: none; }
	.back span { width: 2.25rem; height: 2.25rem; display: grid; place-items: center; border: 1px solid #1113; border-radius: 50%; transition: transform .2s ease; }
	.back:hover span { transform: translateX(-.25rem); }
	.brand { width: clamp(7.8rem,10vw,10rem); line-height: 0; }
	.brand img { display: block; width: 100%; }
	.page-count { justify-self: end; color: #777; font-size: var(--text-caption); font-weight: 750; line-height: var(--leading-caption); letter-spacing: var(--tracking-caption); text-transform: uppercase; }
	main { padding: 0 clamp(1.25rem,4vw,4.5rem) clamp(2rem,5vw,5rem); }
	.project-hero { width: 100%; max-width: 88rem; margin: 0 auto; padding: clamp(4rem,8vw,8rem) 0 clamp(3rem,6vw,6rem); }
	.eyebrow,.section-label,.showcase-head > span { margin: 0; color: var(--color-accent); font-size: var(--text-label); font-weight: 800; line-height: var(--leading-label); letter-spacing: var(--tracking-label); text-transform: uppercase; }
	.hero-row { display: grid; grid-template-columns: minmax(0,1fr) minmax(20rem,.42fr); gap: 4rem; align-items: start; }
	header > *,.hero-row > *,.section-grid > *,.showcase-head > *,.cover-stage > *,.spread-pair > *,.covers-grid > *,.news-grid > * { min-width: 0; }
	h1 { margin: 0; font-size: var(--text-page-title); font-weight: var(--weight-page-title); line-height: var(--leading-page-title); letter-spacing: var(--tracking-page-title); }
	h1 .title-accent { display:block; color:var(--color-accent); font-family:inherit; font-size:1em; font-style:normal; font-weight:inherit; line-height:inherit; letter-spacing:inherit; overflow-wrap:anywhere; }
	.summary { color: #555; font-size: var(--text-page-intro); font-weight: var(--weight-page-intro); line-height: var(--leading-page-intro); }
	.summary p { margin: 0; }
	.summary p + p { margin-top: 1.25rem; }
	.cover-stage { width: 100%; max-width: 88rem; height: clamp(34rem,60vw,61rem); margin: 0 auto; padding: clamp(2rem,5vw,5rem); display: flex; justify-content: center; align-items: center; gap: clamp(1rem,3vw,3rem); background: #0b0b0b; border-radius: var(--radius-shell); overflow: hidden; }
	.cover { flex: 0 1 26%; filter: drop-shadow(0 2rem 2rem #001a); }
	.cover-main { flex-basis: 32%; transform: translateY(-1%); }
	.cover-small:first-child { transform: rotate(-6deg) translateY(5%); }
	.cover-small:last-child { transform: rotate(6deg) translateY(5%); }
	.cover img { display: block; width: 100%; height: auto; border-radius: var(--radius-thumb); }
	.section-grid { width: 100%; max-width: 82rem; margin: 0 auto; display: grid; grid-template-columns: minmax(10rem,.28fr) minmax(0,1fr); gap: clamp(2rem,7vw,8rem); }
	.overview { padding: clamp(6rem,12vw,12rem) 0 clamp(4rem,8vw,8rem); }
	.rich-text h2,.showcase-head h2 { margin: 0; font-size: var(--text-display-section); line-height: var(--leading-display-section); letter-spacing: var(--tracking-display-section); }
	.rich-text p { max-width: 51rem; margin: 1.7rem 0 0; color: #5b5e65; font-size: var(--text-body-lg); line-height: var(--leading-body-lg); }
	.showcase,.covers-section,.news-section { width: 100%; max-width: 88rem; margin: 0 auto; padding: clamp(2rem,4vw,4rem); border-radius: var(--radius-shell); }
	.showcase-sky { background: #f5f5f3; }
	.showcase-head { display: grid; grid-template-columns: minmax(0,.25fr) minmax(0,1fr) minmax(0,.55fr); gap: clamp(1.5rem,4vw,4rem); align-items: end; margin-bottom: clamp(2rem,5vw,5rem); }
	.showcase-head p { margin: 0; color: #5f626a; line-height: 1.65; }
	.spread-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .3rem; align-items: start; }
	.spread-pair img,.covers-grid img,.news-grid img { display: block; width: 100%; height: auto; }
	.showcase .spread-pair { width: min(88%,70rem); margin: 0 auto; box-shadow: 0 2rem 5rem #0002; }
	.spread-frame { width: 100%; max-width: 88rem; margin: 0 auto; padding: clamp(2rem,5vw,5rem); border-radius: var(--radius-shell); }
	.spread-frame-light { margin-top: clamp(4rem,8vw,8rem); background: #f5f5f3; }
	.spread-frame-white { background: #f4f4f1; }
	.spread-frame .spread-pair { width: min(82%,68rem); margin: 0 auto; box-shadow: 0 2rem 5rem #0002; }
	.covers-section { margin-top: clamp(7rem,12vw,12rem); color: #fff; background: #0b0b0b; }
	.showcase-head-light > span { color: var(--color-accent); }
	.showcase-head-light p { color: #ffffffa8; }
	.covers-grid { width: min(72%,57rem); margin: 0 auto; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(1rem,4vw,4rem); align-items: end; }
	.covers-grid img { box-shadow: 0 2rem 4rem #0019; }
	.covers-grid img:first-child { transform: rotate(-3deg); }
	.covers-grid img:last-child { transform: rotate(3deg); }
	.journal-section { width: 100%; max-width: 88rem; margin: 0 auto; padding-top: clamp(7rem,12vw,12rem); }
	.news-section { margin-top: clamp(7rem,12vw,12rem); color: #fff; background: #0d0d0d; }
	.news-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .75rem; }
	.news-grid img:nth-child(even) { transform: translateY(3rem); }
	.closing-section { padding: clamp(8rem,14vw,14rem) 0 clamp(3rem,5vw,5rem); }
	.closing-section :global(.case-results strong) { font-size: clamp(1.25rem,1.5vw,1.5rem); overflow-wrap: normal; }
	.gallery-only-title { margin: 0 0 clamp(3rem,6vw,6rem); font-size: var(--text-display-section); line-height: var(--leading-display-section); letter-spacing: var(--tracking-display-section); }
	@media (max-width:900px) {
		.hero-row,.showcase-head { grid-template-columns: minmax(0,1fr); gap: 1.5rem; }
		.summary { max-width: 38rem; }
		.news-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
		.news-grid img:nth-child(even) { transform: none; }
	}
	@media (max-width:620px) {
		header { height: 4.75rem; padding: 0 1rem; grid-template-columns: minmax(0,1fr); }
		.brand,.page-count { display: none; }
		main { padding-inline: 1rem; }
		.project-hero { padding: 3.5rem 0 3rem; }
		.eyebrow,.section-label,.showcase-head > span { overflow-wrap: anywhere; }
		h1 { max-width: 100%; }
		.summary { max-width: 100%; overflow-wrap: anywhere; }
		.cover-stage { height: 27rem; padding: 1rem; gap: .5rem; }
		.cover { flex-basis: 31%; }
		.cover-main { flex-basis: 43%; }
		.section-grid { grid-template-columns: minmax(0,1fr); gap: 1.5rem; }
		.rich-text h2,.showcase-head h2 { overflow-wrap: anywhere; }
		.rich-text p,.showcase-head p { overflow-wrap: anywhere; }
		.showcase,.covers-section,.news-section,.spread-frame { padding: 1rem; }
		.spread-pair { grid-template-columns: minmax(0,1fr); gap: .75rem; }
		.showcase .spread-pair,.spread-frame .spread-pair { width: 100%; box-shadow: none; }
		.covers-grid { width: 100%; gap: .75rem; }
		.covers-grid img { transform: none !important; }
		.news-grid { grid-template-columns: minmax(0,1fr); }
	}
	@media (prefers-reduced-motion:reduce) { * { scroll-behavior:auto !important; transition-duration:.01ms !important; } }
	:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
</style>
