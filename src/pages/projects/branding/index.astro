---
import BackToTop from '../../../components/BackToTop.astro';
import ProjectFooter from '../../../components/ProjectFooter.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const projects = [
	{
		slug: 'osce-box',
		title: 'ОБСЕ',
		type: 'Подарочная упаковка',
		description: 'Подарочная коробка для кампании ОБСЕ «16 дней активизма против гендерного насилия». Орнаментальная графика встроена в заданную оранжевую палитру кампании.',
		images: [
			{ src: '/portfolio/branding/osce-box.webp', alt: 'Подарочная коробка ОБСЕ для кампании 16 дней активизма' },
		],
	},
	{
		slug: 'discovery-cups',
		title: 'Стаканы Discovery Coffee',
		type: 'Достопримечательности Казахстана',
		description: 'Серия бумажных стаканов Discovery Coffee с иллюстрациями достопримечательностей и узнаваемых образов Казахстана. Каждый сюжет работает самостоятельно и остаётся частью общей яркой серии.',
		images: [
			{ src: '/portfolio/branding/discovery-cups-mountains.webp', alt: 'Бумажные стаканы Discovery Coffee с горным сюжетом' },
			{ src: '/portfolio/branding/discovery-cups-lake.webp', alt: 'Бумажные стаканы Discovery Coffee с пейзажем у озера' },
			{ src: '/portfolio/branding/discovery-cups-yurt.webp', alt: 'Бумажные стаканы Discovery Coffee с интерьером юрты' },
			{ src: '/portfolio/branding/discovery-cup-pattern.webp', alt: 'Бумажный стакан Discovery Coffee с цветным паттерном' },
		],
	},
	{
		slug: 'discovery-tea-coffee',
		title: 'Чай и кофе Discovery Coffee',
		type: 'Упаковка',
		description: 'Упаковка чая и кофе Discovery Coffee. Иллюстративная система объединяет разные продукты бренда, сохраняя различия между категориями и заметность на полке.',
		images: [
			{ src: '/portfolio/branding/discovery-coffee-pack.webp', alt: 'Упаковка кофе Discovery Coffee' },
			{ src: '/portfolio/branding/discovery-tea-pack.webp', alt: 'Упаковка чая Discovery Coffee' },
		],
	},
	{
		slug: 'irtysh-agroservice',
		title: 'Иртыш Агросервис',
		type: 'Многостраничная брошюра',
		description: 'Двенадцатистраничная продуктовая брошюра для официального дистрибьютора Massey Ferguson. Технические характеристики собраны в устойчивую редакционную систему и дополнены крупными фотографиями техники.',
		document: true,
		images: Array.from({ length: 12 }, (_, index) => ({
			src: `/portfolio/branding/irtysh/page-${String(index + 1).padStart(2, '0')}.webp`,
			alt: `Брошюра Иртыш Агросервис, страница ${index + 1}`,
		})),
	},
	{
		slug: 'whisky-rum-wine',
		title: 'Whisky Rum',
		type: 'Винная карта',
		description: 'Шестистраничная винная карта: лаконичная обложка, компактная типографика и последовательная навигация по регионам, категориям и позициям.',
		document: true,
		images: Array.from({ length: 6 }, (_, index) => ({
			src: `/portfolio/branding/wine/page-${String(index + 1).padStart(2, '0')}.webp`,
			alt: `Винная карта Whisky Rum, страница ${index + 1}`,
		})),
	},
	{
		slug: 'frnds',
		title: 'Frnds',
		type: 'Листовка',
		description: 'Двусторонняя листовка для пиццерии Frnds: лицевая сторона работает на аппетитный образ продукта, оборотная быстро сообщает меню, адрес и контакты.',
		images: [
			{ src: '/portfolio/branding/frnds-flyer-mockup.webp', alt: 'Двусторонняя листовка Frnds' },
			{ src: '/portfolio/branding/frnds-flyer-front.webp', alt: 'Лицевая сторона листовки Frnds' },
			{ src: '/portfolio/branding/frnds-flyer-back.webp', alt: 'Оборотная сторона листовки Frnds' },
		],
	},
	{
		slug: 'lux-beauty',
		title: 'Lux Beauty',
		type: 'Подарочный сертификат',
		description: 'Подарочный сертификат для студии Lux Beauty. Макет объединяет фирменный знак, спокойную палитру и понятную структуру для печати и последующего заполнения.',
		images: [
			{ src: '/portfolio/branding/lux-certificate-mockup.webp', alt: 'Подарочный сертификат Lux Beauty в мокапе' },
			{ src: '/portfolio/branding/lux-certificate-front.webp', alt: 'Лицевая сторона сертификата Lux Beauty' },
			{ src: '/portfolio/branding/lux-certificate-back.webp', alt: 'Оборотная сторона сертификата Lux Beauty' },
		],
	},
];

function groupDocumentPages<T>(pages: T[]) {
	return pages.reduce<T[][]>((spreads, page, index) => {
		if (index === 0 || index % 2 === 1) spreads.push([page]);
		else spreads.at(-1)?.push(page);
		return spreads;
	}, []);
}
---

<BaseLayout
	title="Упаковка и брендинг материалы — Федор Юрецкий"
	description="Упаковка, листовки, сертификаты и другие брендинг-материалы в портфолио Федора Юрецкого."
>
	<SiteHeader />

	<main>
		<header class="page-heading">
			<h1>Упаковка и<br />брендинг материалы</h1>
		</header>

		<section class="project-grid" aria-label="Проекты по упаковке и брендинг-материалам">
			{projects.map((project) => (
				<button class="project-card" type="button" data-article-target={`article-${project.slug}`} aria-haspopup="dialog">
					<span class="project-cover">
						<ResponsiveImage
							src={project.images[0].src}
							alt=""
							sizes="(max-width: 700px) 100vw, (max-width: 1050px) 50vw, 33vw"
							aria-hidden="true"
						/>
					</span>
					<span class="project-card-copy"><span><small>{project.type}</small><strong>{project.title}</strong></span><i aria-hidden="true">↗</i></span>
				</button>
			))}
		</section>

		{projects.map((project) => (
			<dialog id={`article-${project.slug}`} class="project-dialog" aria-labelledby={`title-${project.slug}`}>
				<div class="dialog-inner">
					<button class="dialog-close" type="button" aria-label="Закрыть"><span aria-hidden="true"></span></button>
					<header class="dialog-heading">
						<small>{project.type}</small>
						<h2 id={`title-${project.slug}`}>{project.title}</h2>
						<p>{project.description}</p>
					</header>
					{'document' in project && project.document ? (
						<section class="document-reader" data-document-reader>
							<div class="document-controls">
								<strong><span data-page-current>1</span> / {groupDocumentPages(project.images).length}</strong>
								<button type="button" data-page-step="-1" aria-label="Предыдущая страница">←</button>
								<button type="button" data-page-step="1" aria-label="Следующая страница">→</button>
							</div>
							<div class="dialog-gallery document-gallery" data-document-gallery>
								{groupDocumentPages(project.images).map((spread, spreadIndex) => (
									<figure class:list={[spread.length === 1 && 'document-spread-single']}>
										<div class="document-spread">
											{spread.map((image) => (
												<ResponsiveImage src={image.src} alt={image.alt} sizes="(max-width: 700px) 50vw, 40vw" />
											))}
										</div>
										<figcaption>
											{spread.length === 1
												? String(spreadIndex === 0 ? 1 : spreadIndex * 2).padStart(2, '0')
												: `${String(spreadIndex * 2).padStart(2, '0')}–${String(spreadIndex * 2 + 1).padStart(2, '0')}`}
										</figcaption>
									</figure>
								))}
							</div>
						</section>
					) : (
						<div class:list={['dialog-gallery', project.images.length === 1 && 'dialog-gallery-single']}>
							{project.images.map((image) => (
								<figure>
									<ResponsiveImage src={image.src} alt={image.alt} sizes="(max-width: 700px) 100vw, 50vw" />
								</figure>
							))}
						</div>
					)}
				</div>
			</dialog>
		))}

		<ProjectFooter />
	</main>

	<BackToTop />
</BaseLayout>

<script>
	let articleTrigger: HTMLElement | null = null;

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const pageButton = target.closest<HTMLButtonElement>('[data-page-step]');
		if (pageButton) {
			const reader = pageButton.closest<HTMLElement>('[data-document-reader]');
			const gallery = reader?.querySelector<HTMLElement>('[data-document-gallery]');
			const pages = [...(gallery?.querySelectorAll<HTMLElement>('figure') ?? [])];
			const index = Math.max(0, Math.min(pages.length - 1, Number(reader?.dataset.page ?? 0) + Number(pageButton.dataset.pageStep)));
			pages[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
			return;
		}

		const trigger = target.closest<HTMLElement>('[data-article-target]');
		if (trigger) {
			const dialog = document.getElementById(trigger.dataset.articleTarget ?? '');
			if (dialog instanceof HTMLDialogElement) {
				articleTrigger = trigger;
				dialog.showModal();
				dialog.querySelector<HTMLButtonElement>('.dialog-close')?.focus();
			}
			return;
		}

		const close = target.closest<HTMLButtonElement>('.dialog-close');
		if (close) close.closest<HTMLDialogElement>('dialog')?.close();
		else if (target instanceof HTMLDialogElement && target.classList.contains('project-dialog')) target.close();
	});

	document.querySelectorAll<HTMLDialogElement>('.project-dialog').forEach((dialog) => {
		dialog.addEventListener('close', () => articleTrigger?.focus());
	});

	document.querySelectorAll<HTMLElement>('[data-document-reader]').forEach((reader) => {
		const gallery = reader.querySelector<HTMLElement>('[data-document-gallery]');
		const pages = [...(gallery?.querySelectorAll<HTMLElement>('figure') ?? [])];
		const current = reader.querySelector<HTMLElement>('[data-page-current]');
		const buttons = [...reader.querySelectorAll<HTMLButtonElement>('[data-page-step]')];
		let frame = 0;
		const update = () => {
			const index = pages.reduce((nearest, page, pageIndex) => Math.abs(page.offsetLeft - (gallery?.scrollLeft ?? 0)) < Math.abs(pages[nearest].offsetLeft - (gallery?.scrollLeft ?? 0)) ? pageIndex : nearest, 0);
			reader.dataset.page = String(index);
			if (current) current.textContent = String(index + 1);
			buttons[0].disabled = index === 0;
			buttons[1].disabled = index === pages.length - 1;
			frame = 0;
		};
		gallery?.addEventListener('scroll', () => {
			if (!frame) frame = requestAnimationFrame(update);
		}, { passive: true });
		update();
	});
</script>

<style>
	main { padding: 0 clamp(1rem,4vw,4.5rem) clamp(2rem,5vw,5rem); }
	.page-heading { width: min(100%,88rem); margin: 0 auto; padding: clamp(4rem,8vw,8rem) 0 clamp(3rem,6vw,6rem); }
	h1 { max-width: 54rem; margin: 0; font-size: var(--text-page-title); font-weight: var(--weight-page-title); line-height: var(--leading-page-title); letter-spacing: var(--tracking-page-title); }
	.project-grid { width: min(100%,88rem); margin: 0 auto; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(.75rem,1.5vw,1.4rem); }
	.project-card { min-width: 0; padding: 0; display: grid; grid-template-rows: minmax(0,1fr) auto; color: #fff; background: var(--color-panel); border: 1px solid var(--color-border); text-align: left; cursor: pointer; overflow: hidden; }
	.project-cover { aspect-ratio: 4 / 5; display: block; overflow: hidden; background: #090909; }
	.project-cover :global(img) { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .35s ease; }
	.project-card:hover .project-cover :global(img) { transform: scale(1.025); }
	.project-card-copy { min-height: 5.3rem; padding: .9rem 1rem; display: grid; grid-template-columns: minmax(0,1fr) 2.4rem; align-items: center; gap: 1rem; border-top: 1px solid var(--color-border); }
	.project-card-copy > span { min-width: 0; display: grid; gap: .25rem; }
	.project-card small,.dialog-heading small { color: var(--color-muted); font-size: var(--text-card-meta); font-style: normal; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
	.project-card strong { font-size: var(--text-card-title); line-height: 1; letter-spacing: -.045em; }
	.project-card i { width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border: 1px solid #454545; font-style: normal; transition: color .2s ease,background .2s ease,transform .2s ease; }
	.project-card:hover i { color: #050505; background: #fff; transform: rotate(45deg); }
	.project-card:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	.project-dialog { width: min(96vw,94rem); max-width: none; max-height: 94dvh; padding: 0; color: #fff; background: #090909; border: 1px solid #444; overflow: hidden; }
	.project-dialog::backdrop { background: rgba(0,0,0,.82); backdrop-filter: blur(6px); }
	.dialog-inner { max-height: 94dvh; padding: clamp(1rem,3vw,3rem); overflow-y: auto; overscroll-behavior: contain; }
	.dialog-close { position: sticky; top: 0; z-index: 2; width: 3rem; height: 3rem; margin: 0 0 0 auto; display: grid; place-items: center; color: #fff; background: #050505; border: 1px solid #fff; cursor: pointer; }
	.dialog-close span { width: 1.2rem; height: 1.2rem; position: relative; display: block; }
	.dialog-close span::before,.dialog-close span::after { content: ''; width: 100%; height: 1px; position: absolute; left: 0; top: 50%; background: currentColor; }
	.dialog-close span::before { transform: rotate(45deg); }
	.dialog-close span::after { transform: rotate(-45deg); }
	.dialog-close:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: calc(var(--focus-ring-offset) * -1); }
	.dialog-heading { max-width: 62rem; margin: clamp(1rem,3vw,3rem) 0 clamp(2rem,5vw,5rem); display: grid; grid-template-columns: minmax(0,1fr) minmax(18rem,.65fr); gap: .65rem clamp(2rem,7vw,8rem); align-items: start; }
	.dialog-heading small { grid-column: 1 / -1; }
	.dialog-heading h2 { margin: 0; font-size: var(--text-display-section); line-height: var(--leading-display-section); letter-spacing: var(--tracking-display-section); }
	.dialog-heading p { margin: 0; color: var(--color-muted); font-size: var(--text-body-lg); line-height: var(--leading-body-lg); }
	.dialog-gallery { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(.6rem,1.25vw,1.2rem); align-items: start; }
	.dialog-gallery figure { margin: 0; min-width: 0; background: #050505; }
	.dialog-gallery :global(img) { width: 100%; height: auto; display: block; }
	.dialog-gallery-single { grid-template-columns: minmax(0,1fr); }
	.dialog-gallery-single figure { max-width: 60rem; margin-inline: auto; }
	.document-reader { min-width: 0; }
	.document-controls { position: sticky; top: 3.5rem; z-index: 1; margin-bottom: .75rem; padding: .35rem 0; display: flex; align-items: center; justify-content: flex-end; gap: .5rem; background: #090909; }
	.document-controls strong { margin-right: auto; color: var(--color-muted); font-size: var(--text-caption); letter-spacing: var(--tracking-caption); }
	.document-controls button { width: 3rem; height: 3rem; padding: 0; color: #fff; background: #050505; border: 1px solid #454545; cursor: pointer; }
	.document-controls button:hover { color: #050505; background: #fff; border-color: #fff; }
	.document-controls button:disabled { color: #555; background: #090909; border-color: #222; cursor: default; }
	.document-controls button:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
	.document-gallery { display: flex; grid-template-columns: none; gap: clamp(.6rem,1.25vw,1.2rem); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-inline: contain; scrollbar-width: thin; }
	.document-gallery figure { flex: 0 0 100%; scroll-snap-align: start; }
	.document-spread { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .3rem; align-items: start; }
	.document-spread-single .document-spread { width: calc(50% - .15rem); margin-inline: auto; grid-template-columns: minmax(0,1fr); }
	.document-spread :global(img) { width: 100%; max-height: 70dvh; object-fit: contain; background: #fff; }
	.document-gallery figcaption { padding: .5rem 0 0; color: var(--color-muted); font-size: var(--text-caption); letter-spacing: var(--tracking-caption); }

	@media (max-width: 1050px) {
		.project-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
	}

	@media (max-width: 700px) {
		main { padding-inline: 1rem; }
		.page-heading { padding: 3.5rem 0 3rem; }
		h1 { font-size: clamp(2.7rem,13vw,4rem); }
		.project-grid { grid-template-columns: minmax(0,1fr); gap: 1rem; }
		.project-cover { aspect-ratio: 4 / 4.5; }
		.project-card-copy { min-height: 4.8rem; padding: .8rem; }
		.project-dialog { width: 100vw; height: 100dvh; max-height: none; border: 0; }
		.dialog-inner { max-height: 100dvh; padding: 1rem; }
		.dialog-heading { margin: 1.5rem 0 2.5rem; grid-template-columns: minmax(0,1fr); gap: .75rem; }
		.dialog-heading small { grid-column: auto; }
		.dialog-heading h2 { font-size: clamp(2.6rem,13vw,3.8rem); }
		.dialog-gallery { grid-template-columns: minmax(0,1fr); gap: .75rem; }
		.document-gallery { display: flex; }
		.document-gallery figure { flex-basis: 100%; }
		.document-gallery :global(img) { max-height: 64dvh; }
	}

	@media (prefers-reduced-motion: reduce) {
		.project-cover :global(img),.project-card i { transition-duration: .01ms; }
	}
</style>
