---
import BackToTop from '../../../components/BackToTop.astro';
import CasePagination from '../../../components/CasePagination.astro';
import ProjectFooter from '../../../components/ProjectFooter.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocale } from '../../../lib/i18n';

const isRu = getLocale(Astro.url.pathname) === 'ru';

const projects = [
	{
		slug: 'osce-box',
		title: isRu ? 'ОБСЕ' : 'OSCE',
		type: isRu ? 'Подарочная упаковка' : 'Gift Packaging',
		description: isRu ? 'Подарочная коробка для кампании ОБСЕ «16 дней активизма против гендерного насилия». Орнаментальная графика встроена в заданную оранжевую палитру кампании.' : 'Gift box for the OSCE “16 Days of Activism against Gender-Based Violence” campaign. The ornamental graphics are integrated into the campaign’s established orange palette.',
		images: [
			{ src: '/portfolio/branding/osce-box.webp', alt: isRu ? 'Подарочная коробка ОБСЕ для кампании 16 дней активизма' : 'OSCE gift box for the 16 Days of Activism campaign' },
		],
	},
	{
		slug: 'discovery-cups',
		title: isRu ? 'Стаканы Discovery Coffee' : 'Discovery Coffee Cups',
		type: isRu ? 'Достопримечательности Казахстана' : 'Kazakhstan Landmarks',
		description: isRu ? 'Серия бумажных стаканов Discovery Coffee с иллюстрациями достопримечательностей и узнаваемых образов Казахстана. Каждый сюжет работает самостоятельно и остаётся частью общей яркой серии.' : 'A series of Discovery Coffee paper cups featuring illustrations of landmarks and recognizable scenes from Kazakhstan. Each illustration works as a standalone piece while remaining part of a bright, cohesive series.',
		images: [
			{ src: '/portfolio/branding/discovery-cups-mountains.webp', alt: isRu ? 'Бумажные стаканы Discovery Coffee с горным сюжетом' : 'Discovery Coffee paper cups with a mountain illustration' },
			{ src: '/portfolio/branding/discovery-cups-lake.webp', alt: isRu ? 'Бумажные стаканы Discovery Coffee с пейзажем у озера' : 'Discovery Coffee paper cups with a lakeside landscape' },
			{ src: '/portfolio/branding/discovery-cups-yurt.webp', alt: isRu ? 'Бумажные стаканы Discovery Coffee с интерьером юрты' : 'Discovery Coffee paper cups with a yurt interior' },
			{ src: '/portfolio/branding/discovery-cup-pattern.webp', alt: isRu ? 'Бумажный стакан Discovery Coffee с цветным паттерном' : 'Discovery Coffee paper cup with a colorful pattern' },
		],
	},
	{
		slug: 'discovery-tea-coffee',
		title: isRu ? 'Чай и кофе Discovery Coffee' : 'Discovery Coffee Tea & Coffee',
		type: isRu ? 'Упаковка' : 'Packaging',
		description: isRu ? 'Упаковка чая и кофе Discovery Coffee. Иллюстративная система объединяет разные продукты бренда, сохраняя различия между категориями и заметность на полке.' : 'Tea and coffee packaging for Discovery Coffee. The illustration system unifies different products across the brand while preserving category distinctions and strong shelf visibility.',
		images: [
			{ src: '/portfolio/branding/discovery-coffee-pack.webp', alt: isRu ? 'Упаковка кофе Discovery Coffee' : 'Discovery Coffee packaging' },
			{ src: '/portfolio/branding/discovery-tea-pack.webp', alt: isRu ? 'Упаковка чая Discovery Coffee' : 'Discovery Coffee tea packaging' },
		],
	},
	{
		slug: 'irtysh-agroservice',
		title: isRu ? 'Иртыш Агросервис' : 'Irtysh Agroservice',
		type: isRu ? 'Многостраничная брошюра' : 'Multi-page Brochure',
		description: isRu ? 'Двенадцатистраничная продуктовая брошюра для официального дистрибьютора Massey Ferguson. Технические характеристики собраны в устойчивую редакционную систему и дополнены крупными фотографиями техники.' : 'A 12-page product brochure for an official Massey Ferguson distributor. Technical specifications are organized into a consistent editorial system and paired with large-scale equipment photography.',
		cover: '/portfolio/branding/irtysh-cover.webp',
		document: true,
		images: Array.from({ length: 12 }, (_, index) => ({
			src: `/portfolio/branding/irtysh/page-${String(index + 1).padStart(2, '0')}.webp`,
			alt: `${isRu ? 'Брошюра Иртыш Агросервис, страница' : 'Irtysh Agroservice brochure, page'} ${index + 1}`,
		})),
	},
	{
		slug: 'whisky-rum-wine',
		title: 'Whisky Rum',
		type: isRu ? 'Винная карта' : 'Wine List',
		description: isRu ? 'Шестистраничная винная карта: лаконичная обложка, компактная типографика и последовательная навигация по регионам, категориям и позициям.' : 'A six-page wine list with a restrained cover, compact typography, and consistent navigation across regions, categories, and individual selections.',
		cover: '/portfolio/branding/wine-cover.webp',
		document: true,
		images: Array.from({ length: 6 }, (_, index) => ({
			src: `/portfolio/branding/wine/page-${String(index + 1).padStart(2, '0')}.webp`,
			alt: `${isRu ? 'Винная карта Whisky Rum, страница' : 'Whisky Rum wine list, page'} ${index + 1}`,
		})),
	},
	{
		slug: 'frnds',
		title: 'Frnds',
		type: isRu ? 'Листовка' : 'Flyer',
		description: isRu ? 'Двусторонняя листовка для пиццерии Frnds: лицевая сторона работает на аппетитный образ продукта, оборотная быстро сообщает меню, адрес и контакты.' : 'A double-sided flyer for Frnds pizzeria: the front focuses on an appetizing product image, while the reverse quickly communicates the menu, address, and contact details.',
		images: [
			{ src: '/portfolio/branding/frnds-flyer-mockup.webp', alt: isRu ? 'Двусторонняя листовка Frnds' : 'Double-sided Frnds flyer' },
			{ src: '/portfolio/branding/frnds-flyer-front.webp', alt: isRu ? 'Лицевая сторона листовки Frnds' : 'Front of the Frnds flyer' },
			{ src: '/portfolio/branding/frnds-flyer-back.webp', alt: isRu ? 'Оборотная сторона листовки Frnds' : 'Back of the Frnds flyer' },
		],
	},
	{
		slug: 'lux-beauty',
		title: 'Lux Beauty',
		type: isRu ? 'Подарочный сертификат' : 'Gift Certificate',
		description: isRu ? 'Подарочный сертификат для студии Lux Beauty. Макет объединяет фирменный знак, спокойную палитру и понятную структуру для печати и последующего заполнения.' : 'A gift certificate for Lux Beauty studio. The layout combines the brand mark, a calm color palette, and a clear structure designed for print and later completion by hand.',
		images: [
			{ src: '/portfolio/branding/lux-certificate-mockup.webp', alt: isRu ? 'Подарочный сертификат Lux Beauty в мокапе' : 'Lux Beauty gift-certificate mockup' },
			{ src: '/portfolio/branding/lux-certificate-front.webp', alt: isRu ? 'Лицевая сторона сертификата Lux Beauty' : 'Front of the Lux Beauty gift certificate' },
			{ src: '/portfolio/branding/lux-certificate-back.webp', alt: isRu ? 'Оборотная сторона сертификата Lux Beauty' : 'Back of the Lux Beauty gift certificate' },
		],
	},
];

function groupDocumentPages<T>(pages: T[]) {
	return pages.reduce<T[][]>((spreads, page, index) => {
		if (index === 0 || index % 2 === 1) spreads.push([page]);
		else spreads.at(-1)?.push(page);
		return spreads;
	}, []);
}
---

<BaseLayout
	title={isRu ? 'Упаковка и брендинг материалы — Федор Юрецкий' : 'Packaging & Brand Materials — Fedor Jurecki'}
	description={isRu ? 'Упаковка, листовки, сертификаты и другие брендинг-материалы в портфолио Федора Юрецкого.' : 'Packaging, flyers, certificates, and other brand materials by Fedor Jurecki.'}
>
	<SiteHeader />

	<main>
		<header class="page-heading">
			<h1>{isRu ? <>Упаковка и<br />брендинг материалы</> : <>Packaging &<br />Brand Materials</>}</h1>
		</header>

		<section class="project-grid" aria-label={isRu ? 'Проекты по упаковке и брендинг-материалам' : 'Packaging and brand-material projects'}>
			{projects.map((project) => (
				<button class="project-card" type="button" data-article-target={`article-${project.slug}`} aria-haspopup="dialog">
					<span class="project-cover">
						<ResponsiveImage
							src={'cover' in project ? project.cover : project.images[0].src}
							alt=""
							sizes="(max-width: 700px) 100vw, (max-width: 1050px) 50vw, 33vw"
							aria-hidden="true"
						/>
					</span>
					<span class="project-card-copy"><span><small>{project.type}</small><strong>{project.title}</strong></span><i aria-hidden="true">↗</i></span>
				</button>
			))}
		</section>

		{projects.map((project) => (
			<dialog id={`article-${project.slug}`} class="project-dialog" aria-labelledby={`title-${project.slug}`}>
				<div class="dialog-inner">
					<button class="dialog-close" type="button" aria-label={isRu ? 'Закрыть' : 'Close'}><span aria-hidden="true"></span></button>
					<header class="dialog-heading">
						<small>{project.type}</small>
						<h2 id={`title-${project.slug}`}>{project.title}</h2>
						<p>{project.description}</p>
					</header>
					{'document' in project && project.document ? (
						<section class="document-reader" data-document-reader>
							<div class="document-controls">
								<strong><span data-page-current>1</span> / <span data-page-total>{groupDocumentPages(project.images).length}</span></strong>
								<button type="button" data-page-step="-1" aria-label={isRu ? 'Предыдущая страница' : 'Previous page'}>←</button>
								<button type="button" data-page-step="1" aria-label={isRu ? 'Следующая страница' : 'Next page'}>→</button>
							</div>
							<div class="dialog-gallery document-gallery" data-document-gallery>
								{groupDocumentPages(project.images).map((spread, spreadIndex) => (
									<figure class:list={[spread.length === 1 && 'document-spread-single']} data-active={spreadIndex === 0 ? '' : undefined}>
										<div class="document-spread">
											{spread.map((image) => (
												<ResponsiveImage src={image.src} alt={image.alt} sizes="(max-width: 700px) 100vw, 40vw" />
											))}
										</div>
										<figcaption>
											{spread.length === 1
												? String(spreadIndex === 0 ? 1 : spreadIndex * 2).padStart(2, '0')
												: `${String(spreadIndex * 2).padStart(2, '0')}–${String(spreadIndex * 2 + 1).padStart(2, '0')}`}
										</figcaption>
									</figure>
								))}
							</div>
						</section>
					) : (
						<div class:list={['dialog-gallery', project.images.length === 1 && 'dialog-gallery-single', project.slug === 'frnds' && 'dialog-gallery-frnds']}>
							{project.images.map((image) => (
								<figure>
									<button class="dialog-gallery-zoom" type="button" data-lightbox-target="case-image-lightbox" data-caption={image.alt} aria-label={`${isRu ? 'Увеличить' : 'Enlarge'}: ${image.alt}`}>
										<ResponsiveImage src={image.src} alt={image.alt} sizes="(max-width: 700px) 100vw, 50vw" />
									</button>
								</figure>
							))}
						</div>
					)}
				</div>
			</dialog>
		))}

		<CasePagination
			previous={{ href: '/projects/presentations/', label: isRu ? 'Презентации' : 'Presentations' }}
			next={{ href: '/projects/product-design/shelfr/', label: 'Shelfr' }}
		/>
		<ProjectFooter />
	</main>

	<BackToTop />
</BaseLayout>

<script>
	let articleTrigger: HTMLElement | null = null;

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const trigger = target.closest<HTMLElement>('[data-article-target]');
		if (trigger) {
			const dialog = document.getElementById(trigger.dataset.articleTarget ?? '');
			if (dialog instanceof HTMLDialogElement) {
				articleTrigger = trigger;
				dialog.showModal();
				dialog.querySelector<HTMLButtonElement>('.dialog-close')?.focus();
			}
			return;
		}

		const close = target.closest<HTMLButtonElement>('.dialog-close');
		if (close) close.closest<HTMLDialogElement>('dialog')?.close();
		else if (target instanceof HTMLDialogElement && target.classList.contains('project-dialog')) target.close();
	});

	document.querySelectorAll<HTMLDialogElement>('.project-dialog').forEach((dialog) => {
		dialog.addEventListener('close', () => articleTrigger?.focus());
	});

	document.querySelectorAll<HTMLElement>('[data-document-reader]').forEach((reader) => {
		const mobile = matchMedia('(max-width: 700px)');
		const spreads = [...reader.querySelectorAll<HTMLElement>('[data-document-gallery] figure')];
		const pages = [...reader.querySelectorAll<HTMLImageElement>('[data-document-gallery] img')];
		const current = reader.querySelector<HTMLElement>('[data-page-current]');
		const total = reader.querySelector<HTMLElement>('[data-page-total]');
		const buttons = [...reader.querySelectorAll<HTMLButtonElement>('[data-page-step]')];
		let index = 0;

		const update = (next: number) => {
			const items = mobile.matches ? pages : spreads;
			index = Math.max(0, Math.min(items.length - 1, next));
			spreads.forEach((spread, spreadIndex) => spread.toggleAttribute('data-active', mobile.matches ? spread.contains(pages[index]) : spreadIndex === index));
			pages.forEach((page, pageIndex) => page.toggleAttribute('data-mobile-active', mobile.matches && pageIndex === index));
			if (current) current.textContent = String(index + 1);
			if (total) total.textContent = String(items.length);
			buttons[0].disabled = index === 0;
			buttons[1].disabled = index === items.length - 1;
		};

		buttons.forEach((button) => button.addEventListener('click', () => update(index + Number(button.dataset.pageStep))));
		mobile.addEventListener('change', () => update(0));
		update(0);
	});
</script>

<style>
	main { padding: 0 clamp(1rem,4vw,4.5rem) clamp(2rem,5vw,5rem); }
	.page-heading { width: min(100%,88rem); margin: 0 auto; padding: clamp(4rem,8vw,8rem) 0 clamp(3rem,6vw,6rem); }
	h1 { max-width: 54rem; margin: 0; font-size: var(--text-page-title); font-weight: var(--weight-page-title); line-height: var(--leading-page-title); letter-spacing: var(--tracking-page-title); }
	.project-grid { width: min(100%,88rem); margin: 0 auto; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(.75rem,1.5vw,1.4rem); }
	.project-card { min-width: 0; padding: 0; display: grid; grid-template-rows: minmax(0,1fr) auto; color: #fff; background: var(--color-panel); border: 1px solid var(--color-border); text-align: left; cursor: pointer; overflow: hidden; }
	.project-cover { aspect-ratio: 1; display: block; overflow: hidden; background: #090909; }
	.project-cover :global(img) { width: 100%; height: 100%; display: block; object-fit: contain; }
	.project-card-copy { min-height: 5.3rem; padding: .9rem 1rem; display: grid; grid-template-columns: minmax(0,1fr) 2.4rem; align-items: center; gap: 1rem; border-top: 1px solid var(--color-border); }
	.project-card-copy > span { min-width: 0; display: grid; gap: .25rem; }
	.project-card small,.dialog-heading small { color: var(--color-muted); font-size: var(--text-card-meta); font-style: normal; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
	.project-card strong { font-size: var(--text-card-title); line-height: 1; letter-spacing: -.045em; }
	.project-card i { width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border: 1px solid #454545; font-style: normal; transition: color .2s ease,background .2s ease,transform .2s ease; }
	.project-card:hover i { color: #050505; background: #fff; transform: rotate(45deg); }
	.project-card:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	.project-dialog { width: min(96vw,94rem); max-width: none; max-height: 94dvh; padding: 0; color: #fff; background: #090909; border: 1px solid #444; overflow: hidden; }
	.project-dialog::backdrop { background: rgba(0,0,0,.82); backdrop-filter: blur(6px); }
	.dialog-inner { max-height: 94dvh; padding: clamp(1rem,3vw,3rem); overflow-y: auto; overscroll-behavior: contain; }
	.dialog-close { position: sticky; top: 0; z-index: 2; width: 3rem; height: 3rem; margin: 0 0 0 auto; display: grid; place-items: center; color: #fff; background: #050505; border: 1px solid #fff; cursor: pointer; }
	.dialog-close span { width: 1.2rem; height: 1.2rem; position: relative; display: block; }
	.dialog-close span::before,.dialog-close span::after { content: ''; width: 100%; height: 1px; position: absolute; left: 0; top: 50%; background: currentColor; }
	.dialog-close span::before { transform: rotate(45deg); }
	.dialog-close span::after { transform: rotate(-45deg); }
	.dialog-close:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: calc(var(--focus-ring-offset) * -1); }
	.dialog-heading { max-width: 62rem; margin: clamp(1rem,3vw,3rem) 0 clamp(2rem,5vw,5rem); display: grid; grid-template-columns: minmax(0,1fr) minmax(18rem,.65fr); gap: .65rem clamp(2rem,7vw,8rem); align-items: start; }
	.dialog-heading small { grid-column: 1 / -1; }
	.dialog-heading h2 { margin: 0; font-size: var(--text-display-section); line-height: var(--leading-display-section); letter-spacing: var(--tracking-display-section); }
	.dialog-heading p { margin: 0; color: var(--color-muted); font-size: var(--text-body-lg); line-height: var(--leading-body-lg); }
	.dialog-gallery { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(.6rem,1.25vw,1.2rem); align-items: start; }
	.dialog-gallery figure { margin: 0; min-width: 0; background: #050505; }
	.dialog-gallery :global(img) { width: 100%; height: auto; display: block; }
	.dialog-gallery-zoom { width: 100%; padding: 0; display: block; background: transparent; border: 0; cursor: zoom-in; }
	.dialog-gallery-zoom:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: calc(var(--focus-ring-offset) * -1); }
	.dialog-gallery-single { grid-template-columns: minmax(0,1fr); }
	.dialog-gallery-single figure { max-width: 60rem; margin-inline: auto; }
	.dialog-gallery-frnds { grid-template-columns: minmax(0,2fr) minmax(15rem,1fr); }
	.dialog-gallery-frnds figure:first-child { grid-row: span 2; }
	.dialog-gallery-frnds figure:not(:first-child) { align-self: center; }
	.dialog-gallery-frnds figure:not(:first-child) :global(img) { width: auto; max-width: 100%; max-height: 32rem; margin-inline: auto; }
	.document-reader { min-width: 0; display: grid; grid-template: "counter counter counter" auto "previous gallery next" auto / 3rem minmax(0,1fr) 3rem; align-items: center; gap: .75rem; }
	.document-controls { display: contents; }
	.document-controls strong { grid-area: counter; color: var(--color-muted); font-size: var(--text-caption); letter-spacing: var(--tracking-caption); }
	.document-controls button { width: 3rem; height: 3rem; padding: 0; color: #fff; background: #050505; border: 1px solid #454545; cursor: pointer; }
	.document-controls button:first-of-type { grid-area: previous; }
	.document-controls button:last-of-type { grid-area: next; }
	.document-controls button:hover { color: #050505; background: #fff; border-color: #fff; }
	.document-controls button:disabled { color: #555; background: #090909; border-color: #222; cursor: default; }
	.document-controls button:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
	.document-gallery { grid-area: gallery; min-width: 0; display: block; }
	.document-gallery figure { display: none; }
	.document-gallery figure[data-active] { display: block; }
	.document-spread { --spread-gap: .3rem; width: 100%; min-height: 0; display: flex; justify-content: center; align-items: center; gap: var(--spread-gap); }
	.document-spread :global(img) { width: auto; max-width: calc((100% - var(--spread-gap)) / 2); height: auto; max-height: calc(100dvh - 8rem); display: block; object-fit: contain; background: #fff; }
	.document-spread-single .document-spread :global(img) { max-width: 50%; }
	.document-gallery figcaption { padding: .5rem 0 0; color: var(--color-muted); font-size: var(--text-caption); letter-spacing: var(--tracking-caption); }

	@media (max-width: 1050px) {
		.project-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
	}

	@media (max-width: 700px) {
		main { padding-inline: 1rem; }
		.page-heading { padding: 3.5rem 0 3rem; }
		h1 { font-size: clamp(2.7rem,13vw,4rem); }
		.project-grid { grid-template-columns: minmax(0,1fr); gap: 1rem; }
		.project-cover { aspect-ratio: 1; }
		.project-card-copy { min-height: 4.8rem; padding: .8rem; }
		.project-dialog { width: 100vw; height: 100dvh; max-height: none; border: 0; }
		.dialog-inner { max-height: 100dvh; padding: 1rem; }
		.dialog-heading { margin: 1.5rem 0 2.5rem; grid-template-columns: minmax(0,1fr); gap: .75rem; }
		.dialog-heading small { grid-column: auto; }
		.dialog-heading h2 { font-size: clamp(2.6rem,13vw,3.8rem); }
		.dialog-gallery { grid-template-columns: minmax(0,1fr); gap: .75rem; }
		.document-reader { grid-template: "counter counter counter" auto "gallery gallery gallery" auto "previous . next" auto / 2.5rem minmax(0,1fr) 2.5rem; gap: .75rem .35rem; }
		.document-controls button { width: 2.5rem; height: 2.5rem; }
		.document-spread { display: block; width: 100%; }
		.document-spread :global(img) { display: none; width: 100%; max-width: none; max-height: none; }
		.document-spread :global(img[data-mobile-active]) { display: block; }
		.document-spread-single .document-spread :global(img) { max-width: none; }
		.document-gallery figcaption { display: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card i { transition-duration: .01ms; }
	}
</style>
