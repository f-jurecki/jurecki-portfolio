---
import BackToTop from '../../../components/BackToTop.astro';
import CaseGallery from '../../../components/CaseGallery.astro';
import CaseLightbox from '../../../components/CaseLightbox.astro';
import CasePagination from '../../../components/CasePagination.astro';
import ProjectFooter from '../../../components/ProjectFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocale, localizedPath } from '../../../lib/i18n';

const locale = getLocale(Astro.url.pathname);
const isRu = locale === 'ru';

const tools = ['PowerPoint', 'Google Slides', 'Keynote', 'Figma'];

const groups = [
	{ folder: 'business', count: 9, caption: isRu ? 'Бизнес-презентация' : 'Business Presentation' },
	{ folder: 'infographics', slides: ['01', '02', '06'], caption: isRu ? 'Инфографика' : 'Infographics' },
	{ folder: 'education', count: 21, caption: isRu ? 'Образовательная презентация' : 'Educational Presentation' },
];

const galleryItems = groups.flatMap((group) => {
	const slides = group.slides ?? Array.from({ length: group.count ?? 0 }, (_, index) => String(index + 1).padStart(2, '0'));
	return slides.map((slide) => ({
		caption: group.caption,
		images: [{
			src: `/portfolio/presentations/${group.folder}/slide-${slide}.webp`,
			alt: `${group.caption}: ${isRu ? 'слайд' : 'slide'} ${slide}`,
		}],
	}));
}).map((item, index) => ({ ...item, number: String(index + 1).padStart(2, '0') }));
---

<BaseLayout
	title={isRu ? 'Презентации — Федор Юрецкий' : 'Presentations — Fedor Jurecki'}
	description={isRu ? 'Дизайн презентаций Федора Юрецкого: структура, визуальный язык, вёрстка и инфографика на казахском, русском и английском языках.' : 'Presentation design: structure, visual language, layout, and infographics in Kazakh, Russian, and English.'}
>
	<SiteHeader />

	<main>
		<section class="project-intro">
			<h1>{isRu ? 'Презентации' : 'Presentations'}</h1>
			<div class="intro-copy">
				<p>{isRu ? 'У меня большой опыт работы с презентациями на казахском, русском и английском языках — для самых разных сфер, задач и аудиторий. Работаю как с корпоративными и аналитическими материалами, так и с более визуальными и имиджевыми форматами.' : 'I have extensive experience designing presentations in Kazakh, Russian, and English for a wide range of industries, objectives, and audiences. I work with both corporate and analytical materials as well as more visual, image-led formats.'}</p>
				<p>{isRu ? <>Умею выстраивать последовательное повествование, структурировать большие объёмы информации и превращать сложные данные в <a href={localizedPath('/projects/infographics', locale)}>понятную и выразительную инфографику</a>. Подбираю визуальный язык под содержание презентации, сохраняя баланс между ясностью, эстетикой и задачей материала.</> : <>I build coherent narratives, structure large volumes of information, and turn complex data into <a href={localizedPath('/projects/infographics', locale)}>clear, expressive infographics</a>. I adapt the visual language to the content of each presentation while balancing clarity, aesthetics, and the purpose of the material.</>}</p>
			</div>
		</section>

		<section class="experience" aria-label={isRu ? 'Опыт работы с презентациями' : 'Presentation experience'}>
			<div class="experience-main">
				<div><strong>{isRu ? 'Любой объём' : 'Any length'}</strong><span>{isRu ? 'от коротких питч-деков до презентаций для крупных проектов' : 'From short pitch decks to presentations for large-scale projects'}</span></div>
				<div><strong>KZ · RU · EN</strong><span>{isRu ? 'казахский, русский и английский языки' : 'Kazakh, Russian, and English'}</span></div>
				<div><strong>{isRu ? 'Любая аудитория' : 'Any audience'}</strong><span>{isRu ? 'команды, руководство, инвесторы, партнёры, клиенты и широкая публика' : 'Teams, executives, investors, partners, clients, and the general public'}</span></div>
			</div>
			<div class="experience-details">
				<p><strong>{isRu ? 'Ответственность' : 'Responsibility'}</strong><span>{isRu ? 'Самостоятельно выстраиваю структуру и логику презентации, работаю с заказчиком и аналитиками, собираю мастер-шаблон и адаптирую визуальную систему под бренд.' : 'I independently build the structure and logic of a presentation, work with clients and analysts, create master templates, and adapt the visual system to the brand.'}</span></p>
				<p><strong>{isRu ? 'Задачи' : 'Typical assignments'}</strong><span>{isRu ? 'Питч-деки, коммерческие и инвестиционные предложения, стратегии, тендерные защиты, отчёты для руководства, обучение и публичные выступления.' : 'Pitch decks, commercial and investment proposals, strategy decks, tender presentations, executive reports, training materials, and public presentations.'}</span></p>
				<p><strong>{isRu ? 'Отрасли' : 'Industries'}</strong><span>{isRu ? 'Финансы и инвестиции, нефтегаз, промышленность, девелопмент, IT и телеком, фармацевтика, ритейл, логистика и консалтинг.' : 'Finance and investment, oil and gas, industrial sectors, real estate development, IT and telecom, pharmaceuticals, retail, logistics, and consulting.'}</span></p>
			</div>
		</section>

		<section class="tools" aria-labelledby="tools-title">
			<h2 id="tools-title">{isRu ? 'Работаю во всех основных редакторах' : 'I work in all major presentation tools'}</h2>
			<ul>{tools.map((tool) => <li>{tool}</li>)}</ul>
		</section>

		<CaseGallery
			label={isRu ? 'Галерея презентаций' : 'Presentation gallery'}
			title=""
			showHeader={false}
			items={galleryItems}
			variant="numbered"
			lightboxId="presentations-lightbox"
			imageSizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 33vw"
		/>

		<CaseLightbox id="presentations-lightbox" variant="single" label={isRu ? 'Увеличенный слайд презентации' : 'Enlarged presentation slide'} />
		<CasePagination
			previous={{ href: '/projects/infographics/', label: isRu ? 'Инфографика' : 'Infographics' }}
			next={{ href: '/projects/branding/', label: isRu ? 'Упаковка и брендинг материалы' : 'Packaging & Brand Materials' }}
		/>
		<ProjectFooter />
	</main>

	<BackToTop />
</BaseLayout>

<style>
	main { padding: 0 clamp(1.25rem,4vw,4.5rem) clamp(2rem,5vw,5rem); }
	.project-intro { width: 100%; max-width: 88rem; margin: 0 auto; padding: clamp(4rem,8vw,7rem) 0 clamp(4rem,7vw,7rem); display: grid; grid-template-columns: minmax(0,1fr) minmax(20rem,.62fr); gap: clamp(2rem,7vw,8rem); align-items: start; }
	.project-intro > *,.experience-main > *,.experience-details > *,.tools > * { min-width: 0; }
	h1 { margin: 0; font-size: var(--text-page-title); font-weight: var(--weight-page-title); line-height: var(--leading-page-title); letter-spacing: var(--tracking-page-title); }
	.intro-copy { display: grid; gap: 1.5rem; }
	.intro-copy p { margin: 0; color: var(--color-muted); font-size: var(--text-page-intro); font-weight: var(--weight-page-intro); line-height: var(--leading-page-intro); }
	.intro-copy a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: .18em; }
	.intro-copy a:hover { color: var(--color-accent); }
	.experience { width: 100%; max-width: 88rem; margin: 0 auto clamp(5rem,9vw,9rem); border-top: 1px solid #1112; border-bottom: 1px solid #1112; }
	.experience-main { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); }
	.experience-main div { min-height: clamp(9rem,13vw,12rem); padding: clamp(1rem,2vw,1.6rem); display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; border-right: 1px solid #1112; }
	.experience-main div:last-child { border-right: 0; }
	.experience-main strong { max-width: 17rem; font-size: clamp(2rem,3.2vw,3.5rem); line-height: .92; letter-spacing: -.055em; }
	.experience-main div:nth-child(2) strong { max-width: none; white-space: nowrap; }
	.experience-main span { max-width: 20rem; color: #666; font-size: .84rem; line-height: 1.5; }
	.experience-details { padding: clamp(1rem,2vw,1.5rem); display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(2rem,4vw,4rem); border-top: 1px solid #1112; }
	.experience-details p { margin: 0; display: grid; grid-template-columns: max-content minmax(0,1fr); gap: 1rem; }
	.experience-details strong { padding-top: .2rem; color: var(--color-accent); font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; }
	.experience-details span { color: #555; font-size: .88rem; line-height: 1.6; }
	.tools { width: 100%; max-width: 88rem; margin: 0 auto clamp(5rem,9vw,9rem); display: grid; grid-template-columns: minmax(12rem,.32fr) minmax(0,1fr); gap: clamp(2rem,6vw,7rem); align-items: start; }
	.tools h2 { margin: .15rem 0 0; color: #666; font-size: var(--text-body-lg); line-height: var(--leading-body-lg); font-weight: 500; }
	.tools ul { margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); list-style: none; border-top: 1px solid #1112; border-bottom: 1px solid #1112; }
	.tools li { min-height: clamp(6rem,9vw,8rem); padding: 1rem; display: flex; align-items: flex-end; border-right: 1px solid #1112; font-size: clamp(1.15rem,2vw,1.8rem); font-weight: 750; letter-spacing: -.035em; }
	.tools li:last-child { border-right: 0; }
	:global(.case-gallery-numbered .case-gallery-grid) { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(1.2rem,2vw,2rem) clamp(.65rem,1.2vw,1.2rem); column-count: auto !important; }
	:global(.case-gallery-numbered .case-gallery-trigger) { padding: .35rem; background: #0b0b0b; }
	:global(.case-gallery-numbered .case-gallery-item) { margin-bottom: 0; }

	@media (max-width: 900px) {
		.project-intro { grid-template-columns: minmax(0,1fr); gap: 2rem; }
		.intro-copy { max-width: 48rem; }
		.tools { grid-template-columns: minmax(0,1fr); gap: 1.5rem; }
		.tools h2 { max-width: 25rem; }
		:global(.case-gallery-numbered .case-gallery-grid) { grid-template-columns: repeat(2,minmax(0,1fr)); }
	}

	@media (max-width: 620px) {
		main { padding-inline: 1rem; }
		.project-intro { padding: 3.5rem 0 4rem; }
		.experience { margin-bottom: 5rem; }
		.experience-main { grid-template-columns: minmax(0,1fr); }
		.experience-main div { min-height: 8.5rem; border-right: 0; border-bottom: 1px solid #1112; }
		.experience-main div:last-child { border-bottom: 0; }
		.experience-main strong { font-size: clamp(2.2rem,11vw,3.2rem); }
		.experience-details { grid-template-columns: minmax(0,1fr); gap: 1.5rem; }
		.experience-details p { grid-template-columns: minmax(0,1fr); gap: .55rem; }
		.experience-details strong { padding-top: 0; font-size: .7rem; line-height: 1.45; }
		.tools { margin-bottom: 5rem; }
		.tools ul { grid-template-columns: repeat(2,minmax(0,1fr)); }
		.tools li { min-height: 6.5rem; }
		.tools li:nth-child(2) { border-right: 0; }
		.tools li:nth-child(-n+2) { border-bottom: 1px solid #1112; }
		:global(.case-gallery-numbered .case-gallery-grid) { grid-template-columns: minmax(0,1fr); }
	}

	@media (prefers-reduced-motion: reduce) {
		* { transition-duration: .01ms !important; }
	}
</style>
