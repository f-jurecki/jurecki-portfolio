---
import BackToTop from '../../../components/BackToTop.astro';
import CaseGallery from '../../../components/CaseGallery.astro';
import CaseLightbox from '../../../components/CaseLightbox.astro';
import CasePagination from '../../../components/CasePagination.astro';
import ProjectFooter from '../../../components/ProjectFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const tools = ['PowerPoint', 'Google Slides', 'Keynote', 'Figma'];

const groups = [
	{ folder: 'business', count: 9, caption: 'Бизнес-презентация' },
	{ folder: 'infographics', slides: ['01', '02', '06'], caption: 'Инфографика' },
	{ folder: 'education', count: 21, caption: 'Образовательная презентация' },
];

const galleryItems = groups.flatMap((group) => {
	const slides = group.slides ?? Array.from({ length: group.count ?? 0 }, (_, index) => String(index + 1).padStart(2, '0'));
	return slides.map((slide) => ({
		caption: group.caption,
		images: [{
			src: `/portfolio/presentations/${group.folder}/slide-${slide}.webp`,
			alt: `${group.caption}: слайд ${slide}`,
		}],
	}));
}).map((item, index) => ({ ...item, number: String(index + 1).padStart(2, '0') }));
---

<BaseLayout
	title="Презентации — Федор Юрецкий"
	description="Дизайн презентаций Федора Юрецкого: структура, визуальный язык, вёрстка и инфографика на казахском, русском и английском языках."
>
	<SiteHeader />

	<main>
		<section class="project-intro">
			<h1>Презентации</h1>
			<div class="intro-copy">
				<p>У меня большой опыт работы с презентациями на казахском, русском и английском языках — для самых разных сфер, задач и аудиторий. Работаю как с корпоративными и аналитическими материалами, так и с более визуальными и имиджевыми форматами.</p>
				<p>Умею выстраивать последовательное повествование, структурировать большие объёмы информации и превращать сложные данные в <a href="/projects/infographics">понятную и выразительную инфографику</a>. Подбираю визуальный язык под содержание презентации, сохраняя баланс между ясностью, эстетикой и задачей материала.</p>
			</div>
		</section>

		<section class="experience" aria-label="Опыт работы с презентациями">
			<div class="experience-main">
				<div><strong>Любой объём</strong><span>от коротких питч-деков до презентаций для крупных проектов</span></div>
				<div><strong>KZ · RU · EN</strong><span>казахский, русский и английский языки</span></div>
				<div><strong>Любая аудитория</strong><span>команды, руководство, инвесторы, партнёры, клиенты и широкая публика</span></div>
			</div>
			<div class="experience-details">
				<p><strong>Ответственность</strong><span>Самостоятельно выстраиваю структуру и логику презентации, работаю с заказчиком и аналитиками, собираю мастер-шаблон и адаптирую визуальную систему под бренд.</span></p>
				<p><strong>Задачи</strong><span>Питч-деки, коммерческие и инвестиционные предложения, стратегии, тендерные защиты, отчёты для руководства, обучение и публичные выступления.</span></p>
				<p><strong>Отрасли</strong><span>Финансы и инвестиции, нефтегаз, промышленность, девелопмент, IT и телеком, фармацевтика, ритейл, логистика и консалтинг.</span></p>
			</div>
		</section>

		<section class="tools" aria-labelledby="tools-title">
			<h2 id="tools-title">Работаю во всех основных редакторах</h2>
			<ul>{tools.map((tool) => <li>{tool}</li>)}</ul>
		</section>

		<CaseGallery
			label="Галерея презентаций"
			title=""
			showHeader={false}
			items={galleryItems}
			variant="numbered"
			lightboxId="presentations-lightbox"
			imageSizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 33vw"
		/>

		<CaseLightbox id="presentations-lightbox" variant="single" label="Увеличенный слайд презентации" />
		<CasePagination
			previous={{ href: '/projects/infographics/', label: 'Инфографика' }}
			next={{ href: '/projects/branding/', label: 'Packaging & Applied Branding' }}
		/>
		<ProjectFooter />
	</main>

	<BackToTop />
</BaseLayout>

<style>
	main { padding: 0 clamp(1.25rem,4vw,4.5rem) clamp(2rem,5vw,5rem); }
	.project-intro { width: 100%; max-width: 88rem; margin: 0 auto; padding: clamp(4rem,8vw,7rem) 0 clamp(4rem,7vw,7rem); display: grid; grid-template-columns: minmax(0,1fr) minmax(20rem,.62fr); gap: clamp(2rem,7vw,8rem); align-items: start; }
	.project-intro > *,.experience-main > *,.experience-details > *,.tools > * { min-width: 0; }
	h1 { margin: 0; font-size: var(--text-page-title); font-weight: var(--weight-page-title); line-height: var(--leading-page-title); letter-spacing: var(--tracking-page-title); }
	.intro-copy { display: grid; gap: 1.5rem; }
	.intro-copy p { margin: 0; color: var(--color-muted); font-size: var(--text-page-intro); font-weight: var(--weight-page-intro); line-height: var(--leading-page-intro); }
	.intro-copy a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: .18em; }
	.intro-copy a:hover { color: var(--color-accent); }
	.experience { width: 100%; max-width: 88rem; margin: 0 auto clamp(5rem,9vw,9rem); border-top: 1px solid #1112; border-bottom: 1px solid #1112; }
	.experience-main { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); }
	.experience-main div { min-height: clamp(9rem,13vw,12rem); padding: clamp(1rem,2vw,1.6rem); display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; border-right: 1px solid #1112; }
	.experience-main div:last-child { border-right: 0; }
	.experience-main strong { max-width: 17rem; font-size: clamp(2rem,3.2vw,3.5rem); line-height: .92; letter-spacing: -.055em; }
	.experience-main div:nth-child(2) strong { max-width: none; white-space: nowrap; }
	.experience-main span { max-width: 20rem; color: #666; font-size: .84rem; line-height: 1.5; }
	.experience-details { padding: clamp(1rem,2vw,1.5rem); display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(2rem,4vw,4rem); border-top: 1px solid #1112; }
	.experience-details p { margin: 0; display: grid; grid-template-columns: 5rem minmax(0,1fr); gap: 1rem; }
	.experience-details strong { padding-top: .2rem; color: var(--color-accent); font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; }
	.experience-details span { color: #555; font-size: .88rem; line-height: 1.6; }
	.tools { width: 100%; max-width: 88rem; margin: 0 auto clamp(5rem,9vw,9rem); display: grid; grid-template-columns: minmax(12rem,.32fr) minmax(0,1fr); gap: clamp(2rem,6vw,7rem); align-items: start; }
	.tools h2 { margin: .15rem 0 0; color: #666; font-size: var(--text-body-lg); line-height: var(--leading-body-lg); font-weight: 500; }
	.tools ul { margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); list-style: none; border-top: 1px solid #1112; border-bottom: 1px solid #1112; }
	.tools li { min-height: clamp(6rem,9vw,8rem); padding: 1rem; display: flex; align-items: flex-end; border-right: 1px solid #1112; font-size: clamp(1.15rem,2vw,1.8rem); font-weight: 750; letter-spacing: -.035em; }
	.tools li:last-child { border-right: 0; }
	:global(.case-gallery-numbered .case-gallery-grid) { column-count: 3 !important; }
	:global(.case-gallery-numbered .case-gallery-trigger) { padding: .35rem; background: #0b0b0b; }
	:global(.case-gallery-numbered .case-gallery-item) { margin-bottom: clamp(1.2rem,2vw,2rem); }

	@media (max-width: 900px) {
		.project-intro { grid-template-columns: minmax(0,1fr); gap: 2rem; }
		.intro-copy { max-width: 48rem; }
		.tools { grid-template-columns: minmax(0,1fr); gap: 1.5rem; }
		.tools h2 { max-width: 25rem; }
		:global(.case-gallery-numbered .case-gallery-grid) { column-count: 2 !important; }
	}

	@media (max-width: 620px) {
		main { padding-inline: 1rem; }
		.project-intro { padding: 3.5rem 0 4rem; }
		.experience { margin-bottom: 5rem; }
		.experience-main { grid-template-columns: minmax(0,1fr); }
		.experience-main div { min-height: 8.5rem; border-right: 0; border-bottom: 1px solid #1112; }
		.experience-main div:last-child { border-bottom: 0; }
		.experience-main strong { font-size: clamp(2.2rem,11vw,3.2rem); }
		.experience-details { grid-template-columns: minmax(0,1fr); gap: 1.5rem; }
		.experience-details p { grid-template-columns: minmax(0,1fr); gap: .55rem; }
		.experience-details strong { padding-top: 0; font-size: .7rem; line-height: 1.45; }
		.tools { margin-bottom: 5rem; }
		.tools ul { grid-template-columns: repeat(2,minmax(0,1fr)); }
		.tools li { min-height: 6.5rem; }
		.tools li:nth-child(2) { border-right: 0; }
		.tools li:nth-child(-n+2) { border-bottom: 1px solid #1112; }
		:global(.case-gallery-numbered .case-gallery-grid) { column-count: 1 !important; }
	}

	@media (prefers-reduced-motion: reduce) {
		* { transition-duration: .01ms !important; }
	}
</style>
