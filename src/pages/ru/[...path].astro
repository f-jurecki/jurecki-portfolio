---
import Home from '../index.astro';
import Branding from '../projects/branding/index.astro';
import ComingSoon from '../projects/coming-soon.astro';
import Infographics from '../projects/infographics/index.astro';
import Cards from '../projects/personal/cards/index.astro';
import DigitalScrapbook from '../projects/personal/digital-scrapbook/index.astro';
import Personal from '../projects/personal/index.astro';
import Posters from '../projects/personal/posters/index.astro';
import Republica from '../projects/personal/republica/index.astro';
import Presentations from '../projects/presentations/index.astro';
import Publications from '../projects/publications/index.astro';
import Iofs from '../projects/publications/iofs.astro';
import Kipd from '../projects/publications/kipd.astro';
import Unesco from '../projects/publications/unesco.astro';
import AdobeScripts from '../projects/vibecoding/adobe-scripts/index.astro';
import Deepfries from '../projects/vibecoding/deepfries/index.astro';
import Vibecoding from '../projects/vibecoding/index.astro';
import Sequence from '../projects/vibecoding/sequence/index.astro';

const pages = {
	home: Home,
	branding: Branding,
	'coming-soon': ComingSoon,
	infographics: Infographics,
	cards: Cards,
	'digital-scrapbook': DigitalScrapbook,
	personal: Personal,
	posters: Posters,
	republica: Republica,
	presentations: Presentations,
	publications: Publications,
	iofs: Iofs,
	kipd: Kipd,
	unesco: Unesco,
	'adobe-scripts': AdobeScripts,
	deepfries: Deepfries,
	vibecoding: Vibecoding,
	sequence: Sequence,
};

export function getStaticPaths() {
	return [
		[undefined, 'home'],
		['projects/branding', 'branding'],
		['projects/coming-soon', 'coming-soon'],
		['projects/infographics', 'infographics'],
		['projects/personal', 'personal'],
		['projects/personal/cards', 'cards'],
		['projects/personal/digital-scrapbook', 'digital-scrapbook'],
		['projects/personal/posters', 'posters'],
		['projects/personal/republica', 'republica'],
		['projects/presentations', 'presentations'],
		['projects/publications', 'publications'],
		['projects/publications/iofs', 'iofs'],
		['projects/publications/kipd', 'kipd'],
		['projects/publications/unesco', 'unesco'],
		['projects/vibecoding', 'vibecoding'],
		['projects/vibecoding/adobe-scripts', 'adobe-scripts'],
		['projects/vibecoding/deepfries', 'deepfries'],
		['projects/vibecoding/sequence', 'sequence'],
	].map(([path, page]) => ({ params: { path }, props: { page } }));
}

const Page = pages[Astro.props.page as keyof typeof pages];
---

<Page />
