---
import SeoHead from '../components/SeoHead.astro';
import LanguageGate from '../components/LanguageGate.astro';
import { getLocale, localizedPath } from '../lib/i18n';
import '../styles/tokens.css';
import '../styles/dark-theme.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
}

const { title, description, image, imageAlt, noindex } = Astro.props;
const locale = getLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={locale}>
	<head>
		<SeoHead title={title} description={description} image={image} imageAlt={imageAlt} noindex={noindex} />
	</head>
	<body id="top">
		<slot />
		<footer class="privacy-footer"><a href={localizedPath('/privacy/', locale)}>{locale === 'ru' ? 'Приватность' : 'Privacy'}</a></footer>
		<LanguageGate />
	</body>
</html>

<style is:global>
	:root {
		font-family: Inter, "Segoe UI", Arial, sans-serif;
		color: var(--color-text);
		background: var(--color-surface);
		font-synthesis: none;
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; overscroll-behavior-y: none; }
	body { margin: 0; min-width: 0; overflow-x: clip; background: var(--color-surface); }
	h1, h2, h3, h4, h5, h6 { font-family: "TikTok Sans", Inter, "Segoe UI", Arial, sans-serif; }
	a { color: inherit; }
	button { font: inherit; }
	.privacy-footer { min-height: 2.5rem; padding: .65rem clamp(1rem, 3vw, 3rem); display: flex; align-items: center; justify-content: flex-end; color: #9a9a9a; font: 400 .7rem/1.4 Inter, Arial, sans-serif; }
	.privacy-footer a { color: inherit; text-decoration: none; }
	.privacy-footer a:hover { color: #fff; text-decoration: underline; text-underline-offset: .2em; }
	.privacy-footer a:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
</style>
